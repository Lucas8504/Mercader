<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Mercader.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mercader"
    Title="Mercader"
    BackgroundColor="Black"
    Shell.FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="Black">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent Title="Encargo" ContentTemplate="{DataTemplate local:Encargos}" />
    <ShellContent Title="Ventas" ContentTemplate="{DataTemplate local:Venta}" />
    <ShellContent Title="Gasto" ContentTemplate="{DataTemplate local:Gastos}" />

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid ColumnDefinitions=" .8*" HeightRequest="40" RowSpacing="0">
                <Label Grid.Column="1" Margin="10,0,0,0" HorizontalOptions="Center" VerticalOptions="Center" FontSize="17" Text="{Binding Title}" TextColor="#cccccc" />
                <Rectangle Grid.RowSpan=" 4" Fill="WhiteSmoke" Opacity=".1"/>

            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.FlyoutHeader>
        <Grid BackgroundColor="Black">
            <Label
                FontSize="Large"
                HorizontalOptions="Center"
                Text="Mercader"
                TextColor="#cccccc"
                VerticalOptions="Center" />
        </Grid>
    </Shell.FlyoutHeader>
</Shell>

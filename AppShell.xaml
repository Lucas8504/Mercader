<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Mercader.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mercader"
    Title="Mercader"
    BackgroundColor="#6490E9"
    FlyoutBackgroundColor="#1e1e1e"
    Shell.FlyoutBehavior="Flyout">
    

    <!--  Flyout Header  -->
    <Shell.FlyoutHeader>
        <Grid Padding="20" BackgroundColor="#1e1e1e">
            <Label
                FontAttributes="Bold"
                FontSize="24"
                HorizontalOptions="Center"
                Text="Mercader"
                TextColor="#cccccc"
                VerticalOptions="Center" />
        </Grid>
    </Shell.FlyoutHeader>

    <!--  Flyout Footer  -->
    <Shell.FlyoutFooter>
        <Grid Padding="10" BackgroundColor="#1e1e1e">
            <Label
                FontSize="14"
                HorizontalOptions="Center"
                Text="Versión 1.0"
                TextColor="#7d7c7c"
                VerticalOptions="Center" />
        </Grid>
    </Shell.FlyoutFooter>


    <!--  Item Template  -->
    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid
                ColumnDefinitions=".2*,  .8*"
                HeightRequest="50"
                RowSpacing="0">
               
                <!--  Icono (puedes agregar un Image si tienes íconos)  -->
                <BoxView
                    Grid.Column="0"
                    Grid.RowSpan="3"
                    BackgroundColor="#4CAF50"
                    CornerRadius="15"
                    HeightRequest="30"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="30" />
                <!--  Texto del ítem  -->
                <Label
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    FontSize="17"
                    HorizontalOptions="Start"
                    Text="{Binding Title}"
                    TextColor="#cccccc"
                    VerticalOptions="Center" />
                <!--  Texto claro para contraste  -->
                <!--  Separador  -->
                <Rectangle
                    Grid.ColumnSpan="3"
                    Grid.RowSpan="4"
                    Fill="#7d7c7c"
                    HeightRequest="0.5"
                    Opacity="0.2"
                    VerticalOptions="End"
                   />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <!--  Shell Content  -->
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage"
        Grid.Row="0"/>
    <ShellContent Title="Encargo" ContentTemplate="{DataTemplate local:Encargos}" Grid.Row="1" />
    <ShellContent Title="Ventas" ContentTemplate="{DataTemplate local:Venta}"  Grid.Row="2"/>
    <ShellContent Title="Gasto" ContentTemplate="{DataTemplate local:Gastos}"  Grid.Row="3"/>


</Shell>
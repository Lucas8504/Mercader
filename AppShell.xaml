<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Mercader.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mercader"
    Title="Mercader"
    BackgroundColor="Black"
    Shell.FlyoutBehavior="Flyout">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent Title="Encargo" ContentTemplate="{DataTemplate local:Encargos}" />
    <ShellContent Title="Ventas" ContentTemplate="{DataTemplate local:Venta}" />
    <ShellContent Title="Gasto" ContentTemplate="{DataTemplate local:Gastos}" />


    <Shell.FlyoutHeader>
        <Grid BackgroundColor="Black">
            <Label Text="Mercader" TextColor="White" FontSize="Large" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
    </Shell.FlyoutHeader>
</Shell>

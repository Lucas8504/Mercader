<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.EditarEncargoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:picker="clr-namespace:Syncfusion.Maui.Toolkit.Picker;assembly=Syncfusion.Maui.Toolkit"
    Title="Editar Encargo"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout
            Margin="20"
            Padding="20"
            Spacing="20">

            <!-- Título principal -->
            <Label
                FontAttributes="Bold"
                FontSize="24"
                HorizontalTextAlignment="Center"
                Text="Editar Encargo"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <!-- Card principal con el formulario -->
            <Frame
                Padding="20"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="12"
                HasShadow="True">
                <VerticalStackLayout Spacing="20">

                    <!-- Campo Nombre del Cliente -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Nombre del Cliente:"
                            TextColor="#4CAF50" />
                        <Frame
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBackground}, Dark={StaticResource InputBackgroundDark}}"
                            CornerRadius="8"
                            HasShadow="False">
                            <Entry
                                x:Name="NombreEntry"
                                BackgroundColor="Transparent"
                                FontSize="16"
                                Placeholder="Ingrese el nombre del cliente"
                                PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </Frame>
                    </VerticalStackLayout>


                    <!-- Campo de Contacto -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Nombre del Cliente:"
                            TextColor="#4CAF50" />
                        <Frame
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBackground}, Dark={StaticResource InputBackgroundDark}}"
                            CornerRadius="8"
                            HasShadow="False">
                            <Entry
                                x:Name="ContactoEntry"
                                Keyboard="Telephone"
                                BackgroundColor="Transparent"
                                FontSize="16"
                                Placeholder="Ingrese el nombre del cliente"
                                PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </Frame>
                    </VerticalStackLayout>


                    <!-- Campo Descripción -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Descripción del Producto:"
                            TextColor="#4CAF50" />
                        <Frame
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBackground}, Dark={StaticResource InputBackgroundDark}}"
                            CornerRadius="8"
                            HasShadow="False">
                            <Entry
                                x:Name="DescripcionEntry"
                                BackgroundColor="Transparent"
                                FontSize="16"
                                Placeholder="Describe el producto o servicio"
                                PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Grid para Precio y Cantidad -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Campo Precio -->
                        <VerticalStackLayout Grid.Column="0" Spacing="8">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Precio:"
                                TextColor="#4CAF50" />
                            <Frame
                                Padding="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackground}, Dark={StaticResource InputBackgroundDark}}"
                                CornerRadius="8"
                                HasShadow="False">
                                <Entry
                                    x:Name="PrecioEntry"
                                    BackgroundColor="Transparent"
                                    FontSize="16"
                                    Keyboard="Numeric"
                                    Placeholder="0.00"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                    TextColor="#FFC107" />
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Campo Cantidad -->
                        <VerticalStackLayout Grid.Column="2" Spacing="8">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Cantidad:"
                                TextColor="#4CAF50" />
                            <Frame
                                Padding="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackground}, Dark={StaticResource InputBackgroundDark}}"
                                CornerRadius="8"
                                HasShadow="False">
                                <Entry
                                    x:Name="CantidadEntry"
                                    BackgroundColor="Transparent"
                                    FontSize="16"
                                    Keyboard="Numeric"
                                    Placeholder="1"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Campo Fecha de Entrega -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Fecha de Entrega:"
                            TextColor="#4CAF50" />
                        <Frame
                            Padding="10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBackground}, Dark={StaticResource InputBackgroundDark}}"
                            CornerRadius="8"
                            HasShadow="False">
                            <Grid Padding="0,14">
                                <Label
                                    x:Name="FechaEntregaLabel"
                                    FontSize="16"
                                    VerticalOptions="Center"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFechaEntregaTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- SfDatePicker oculto en Dialog mode -->
                    <picker:SfDatePicker
                        x:Name="FechaEntregaPicker"
                        Mode="Dialog"
                        Format="dd_MM_yyyy"
                        HeightRequest="0"
                        Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                        ColumnDividerColor="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}"
                        Closed="OnFechaEntregaPickerClosed">

                        <picker:SfDatePicker.HeaderView>
                            <picker:PickerHeaderView
                                Height="50"
                                Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PageBackgroundDark}}">
                                <picker:PickerHeaderView.TextStyle>
                                    <picker:PickerTextStyle
                                        TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource TextPrimaryDark}}" />
                                </picker:PickerHeaderView.TextStyle>
                            </picker:PickerHeaderView>
                        </picker:SfDatePicker.HeaderView>

                        <picker:SfDatePicker.ColumnHeaderView>
                            <picker:DatePickerColumnHeaderView
                                Height="40"
                                Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource CardAltBackgroundDark}}">
                                <picker:DatePickerColumnHeaderView.TextStyle>
                                    <picker:PickerTextStyle
                                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource TextSecondaryDark}}" />
                                </picker:DatePickerColumnHeaderView.TextStyle>
                            </picker:DatePickerColumnHeaderView>
                        </picker:SfDatePicker.ColumnHeaderView>

                        <picker:SfDatePicker.SelectionView>
                            <picker:PickerSelectionView
                                Background="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource CardBackgroundDark}}"
                                CornerRadius="5"
                                Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </picker:SfDatePicker.SelectionView>

                        <picker:SfDatePicker.TextStyle>
                            <picker:PickerTextStyle
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </picker:SfDatePicker.TextStyle>

                        <picker:SfDatePicker.SelectedTextStyle>
                            <picker:PickerTextStyle
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </picker:SfDatePicker.SelectedTextStyle>

                        <picker:SfDatePicker.FooterView>
                            <picker:PickerFooterView
                                Height="50"
                                Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                                DividerColor="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}">
                                <picker:PickerFooterView.TextStyle>
                                    <picker:PickerTextStyle
                                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                        FontAttributes="Bold" />
                                </picker:PickerFooterView.TextStyle>
                            </picker:PickerFooterView>
                        </picker:SfDatePicker.FooterView>

                    </picker:SfDatePicker>

                    <!-- Información del total calculado -->
                    <Frame
                        Padding="15"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                        CornerRadius="8"
                        HasShadow="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Total Estimado:"
                                TextColor="#4CAF50"
                                VerticalOptions="Center" />
                            <Label
                                x:Name="LabelTotalCalculado"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="$0.00"
                                TextColor="#FFC107"
                                VerticalOptions="Center" />
                        </Grid>
                    </Frame>

                </VerticalStackLayout>
            </Frame>

            <!-- Botones de acción -->
            <VerticalStackLayout Spacing="15">

                <!-- Botón Guardar -->
                <Button
                    x:Name="BtnGuardar"
                    BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#A5D6A7}"
                    Clicked="OnGuardarClicked"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="50"
                    Text="💾 Guardar Cambios"
                    TextColor="White" />

                <!-- Botón Cancelar -->
                <Button
                    x:Name="BtnCancelar"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray200}}"
                    Clicked="OnCancelarClicked"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="50"
                    Text="❌ Cancelar"
                    TextColor="White" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
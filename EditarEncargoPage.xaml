<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.EditarEncargoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:domain="clr-namespace:Mercader.Domain.Entities;assembly=Mercader.Core"
    xmlns:picker="clr-namespace:Syncfusion.Maui.Toolkit.Picker;assembly=Syncfusion.Maui.Toolkit"
    Title="Editar Encargo"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout
            Margin="20"
            Padding="20"
            Spacing="20">

            <!-- Título principal -->
            <Label
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Center"
                Text="Editar Encargo"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <!-- Campo Nombre del Cliente -->
            <Frame
                Padding="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontSize="11"
                        Text="Nombre del Cliente"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    <Entry
                        x:Name="NombreEntry"
                        BackgroundColor="Transparent"
                        Placeholder="Ingrese el nombre del cliente"
                        PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                        Text="{Binding Nombre, Mode=TwoWay}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        Visual="Material" />
                </VerticalStackLayout>
            </Frame>

            <!-- Campo Contacto -->
            <Frame
                Padding="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontSize="11"
                        Text="Número de teléfono"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    <Entry
                        x:Name="ContactoEntry"
                        BackgroundColor="Transparent"
                        Keyboard="Telephone"
                        Placeholder="Ingrese el teléfono"
                        PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                        Text="{Binding Contacto, Mode=TwoWay}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        Visual="Material" />
                </VerticalStackLayout>
            </Frame>

            <!-- Campo Descripción -->
            <Frame
                Padding="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontSize="11"
                        Text="Descripción del Producto"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    <Entry
                        x:Name="DescripcionEntry"
                        BackgroundColor="Transparent"
                        Placeholder="Describe el producto o servicio"
                        PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                        Text="{Binding Descripcion, Mode=TwoWay}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        Visual="Material" />
                </VerticalStackLayout>
            </Frame>

            <!-- Campo Fecha de Entrega -->
            <Frame
                Padding="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontSize="11"
                        Text="Fecha de Entrega"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    <Grid>
                        <Label
                            x:Name="FechaEntregaLabel"
                            FontSize="14"
                            VerticalOptions="Center"
                            Text="{Binding FechaEntrega, StringFormat='{0:dd/MM/yyyy}'}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFechaEntregaTapped" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- SfDatePicker oculto en Dialog mode -->
            <picker:SfDatePicker
                x:Name="FechaEntregaPicker"
                Mode="Dialog"
                Format="dd_MM_yyyy"
                HeightRequest="0"
                Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                ColumnDividerColor="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}"
                Closed="OnFechaEntregaPickerClosed"
                OkButtonClicked="OnFechaEntregaPickerOk"
                CancelButtonClicked="OnFechaEntregaPickerCancelado">

                <picker:SfDatePicker.HeaderView>
                    <picker:PickerHeaderView
                        Height="50"
                        Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PageBackgroundDark}}">
                        <picker:PickerHeaderView.TextStyle>
                            <picker:PickerTextStyle
                                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource TextPrimaryDark}}" />
                        </picker:PickerHeaderView.TextStyle>
                    </picker:PickerHeaderView>
                </picker:SfDatePicker.HeaderView>

                <picker:SfDatePicker.ColumnHeaderView>
                    <picker:DatePickerColumnHeaderView
                        Height="40"
                        Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource CardAltBackgroundDark}}">
                        <picker:DatePickerColumnHeaderView.TextStyle>
                            <picker:PickerTextStyle
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource TextSecondaryDark}}" />
                        </picker:DatePickerColumnHeaderView.TextStyle>
                    </picker:DatePickerColumnHeaderView>
                </picker:SfDatePicker.ColumnHeaderView>

                <picker:SfDatePicker.SelectionView>
                    <picker:PickerSelectionView
                        Background="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource CardBackgroundDark}}"
                        CornerRadius="5"
                        Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </picker:SfDatePicker.SelectionView>

                <picker:SfDatePicker.TextStyle>
                    <picker:PickerTextStyle
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                </picker:SfDatePicker.TextStyle>

                <picker:SfDatePicker.SelectedTextStyle>
                    <picker:PickerTextStyle
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </picker:SfDatePicker.SelectedTextStyle>

                <picker:SfDatePicker.FooterView>
                    <picker:PickerFooterView
                        Height="50"
                        Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                        DividerColor="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}"
                        OkButtonText="OK"
                        CancelButtonText="Cancelar">
                        <picker:PickerFooterView.TextStyle>
                            <picker:PickerTextStyle
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                FontAttributes="Bold" />
                        </picker:PickerFooterView.TextStyle>
                    </picker:PickerFooterView>
                </picker:SfDatePicker.FooterView>

            </picker:SfDatePicker>

            <!-- ===== MULTI-ARTÍCULO ===== -->
            <Label
                FontAttributes="Bold"
                FontSize="16"
                Text="Artículos"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <VerticalStackLayout
                x:Name="ArticulosStack"
                Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="domain:ArticuloEncargo">
                        <Frame
                            Padding="12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                            CornerRadius="8"
                            HasShadow="False">
                            <VerticalStackLayout Spacing="8">
                                <!-- Descripción -->
                                <VerticalStackLayout Spacing="4">
                                    <Label
                                        FontSize="11"
                                        Text="Descripción"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Entry
                                        BackgroundColor="Transparent"
                                        Placeholder="Nombre del artículo"
                                        PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                        Text="{Binding Descripcion, Mode=TwoWay}"
                                        TextChanged="OnArticuloFieldChanged"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                        Visual="Material" />
                                </VerticalStackLayout>

                                <!-- Image picker - small camera icon -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,5,0,0">
                                    <Button
                                        Grid.Column="1"
                                        WidthRequest="36" HeightRequest="36"
                                        Padding="0"
                                        BackgroundColor="{AppThemeBinding Light=#487CE4, Dark=#90CAF9}"
                                        CornerRadius="18"
                                        FontSize="16"
                                        Text="📷"
                                        TextColor="White"
                                        Clicked="OnOpenImageGalleryClicked" />
                                </Grid>

                                <!-- Precio y Cantidad en fila -->
                                <Grid ColumnDefinitions="*,8,*" ColumnSpacing="0">
                                    <!-- Precio Unitario -->
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label
                                            FontSize="11"
                                            Text="Precio Unitario"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                        <Entry
                                            BackgroundColor="Transparent"
                                            Keyboard="Numeric"
                                            Placeholder="0"
                                            PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                            Text="{Binding PrecioUnitario, Mode=TwoWay, Converter={StaticResource DecimalToEmpty}}"
                                            TextChanged="OnArticuloFieldChanged"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            Visual="Material" />
                                    </VerticalStackLayout>

                                    <!-- Cantidad -->
                                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                                        <Label
                                            FontSize="11"
                                            Text="Cantidad"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                        <Entry
                                            BackgroundColor="Transparent"
                                            Keyboard="Numeric"
                                            Placeholder="1"
                                            PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                            Text="{Binding Cantidad, Mode=TwoWay, Converter={StaticResource DecimalToEmpty}}"
                                            TextChanged="OnArticuloFieldChanged"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            Visual="Material" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Botones de acción -->
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                    <Button
                                        Grid.Column="1"
                                        BackgroundColor="Transparent"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type Page}}, Path=BindingContext.SubirArticuloCommand}"
                                        CommandParameter="{Binding .}"
                                        FontSize="14"
                                        Padding="4"
                                        Text="⬆" />
                                    <Button
                                        Grid.Column="2"
                                        BackgroundColor="Transparent"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type Page}}, Path=BindingContext.BajarArticuloCommand}"
                                        CommandParameter="{Binding .}"
                                        FontSize="14"
                                        Padding="4"
                                        Text="⬇" />
                                    <Button
                                        Grid.Column="3"
                                        BackgroundColor="#FF5252"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type Page}}, Path=BindingContext.EliminarArticuloCommand}"
                                        CommandParameter="{Binding .}"
                                        FontSize="14"
                                        Padding="4"
                                        Text="✕"
                                        TextColor="White" />
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Botón Agregar Artículo -->
            <Button
                Padding="10"
                BackgroundColor="{AppThemeBinding Light=#2196F3, Dark=#90CAF9}"
                Command="{Binding AgregarArticuloCommand}"
                CornerRadius="8"
                FontSize="14"
                Text="+ Agregar artículo"
                TextColor="White" />

            <!--  Lista de sugerencias para autocompletado de artículos  -->
            <Frame
                x:Name="ArticuloSuggestionsFrame"
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False"
                IsVisible="False"
                MaximumHeightRequest="200">
                <CollectionView
                    x:Name="ArticuloSuggestionsView"
                    SelectionMode="Single"
                    SelectionChanged="OnArticuloSuggestionSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid
                                Padding="12,10"
                                ColumnSpacing="0"
                                BackgroundColor="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnArticuloSuggestionTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Grid.Column="0"
                                    Text="{Binding .}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    FontSize="15"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="✕"
                                    TextColor="#FF5252"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    Padding="8,4">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnArticuloDismissSuggestionTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>

            <!-- Total calculado -->
            <Frame
                Padding="12"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Total:"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        VerticalOptions="Center" />
                    <Label
                        x:Name="TotalLabel"
                        Grid.Column="2"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="$0"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- Botones de acción -->
            <VerticalStackLayout Spacing="15">
                <Button
                    x:Name="BtnGuardar"
                    Padding="15"
                    BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#007600}"
                    Clicked="OnGuardarClicked"
                    CornerRadius="8"
                    FontSize="16"
                    Text="💾 Guardar Cambios"
                    TextColor="White" />

                <Button
                    x:Name="BtnCancelar"
                    Padding="15"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ButtonSecondaryLight}, Dark={StaticResource ButtonSecondaryDark}}"
                    Clicked="OnCancelarClicked"
                    CornerRadius="8"
                    FontSize="16"
                    Text="❌ Cancelar"
                    TextColor="White" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
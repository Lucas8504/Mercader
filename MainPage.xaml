<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mercader"
    xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
    Title="Inicio"
    BackgroundColor="#1C1C1C">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <!--  Sección Botones Principales  -->
            <HorizontalStackLayout
                Margin="-5,0,0,0"
                HorizontalOptions="Center"
                Spacing="7">

                <Button
                    BackgroundColor="#1f6bc2"
                    Clicked="InAgregarEncargo"
                    CornerRadius="10"
                    Text="📦 Encargo"
                    TextColor="White"
                    WidthRequest="106" />

                <Button
                    BackgroundColor="#2e9449"
                    Clicked="InAgregarVenta"
                    CornerRadius="10"
                    Text="💰 Venta"
                    TextColor="White"
                    WidthRequest="106" />

                <Button
                    BackgroundColor="#6e0a24"
                    Clicked="InAgregarGasto"
                    CornerRadius="10"
                    Text="💸 Gasto"
                    TextColor="White"
                    WidthRequest="106" />
            </HorizontalStackLayout>

            <!--  Sección Resumen Financiero General  -->
            <Frame
                Padding="16"
                BackgroundColor="#2a2a2a"
                CornerRadius="17"
                HasShadow="True">

                <Grid ColumnSpacing="15" RowSpacing="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Encargos  -->
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label
                            FontSize="13"
                            HorizontalOptions="Center"
                            Text="ENCARGOS"
                            TextColor="#7d7c7c" />
                        <Label
                            x:Name="EncargosLabel"
                            FontAttributes="Bold"
                            FontSize="14"
                            HorizontalOptions="Center"
                            TextColor="#1f6bc2" />
                    </VerticalStackLayout>

                    <!--  Ventas  -->
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label
                            FontSize="13"
                            HorizontalOptions="Center"
                            Text="VENTAS"
                            TextColor="#7d7c7c" />
                        <Label
                            x:Name="VentasLabel"
                            FontAttributes="Bold"
                            FontSize="14"
                            HorizontalOptions="Center"
                            TextColor="#2e9449" />
                    </VerticalStackLayout>

                    <!--  Gastos  -->
                    <VerticalStackLayout Grid.Column="2" Spacing="5">
                        <Label
                            FontSize="13"
                            HorizontalOptions="Center"
                            Text="GASTOS"
                            TextColor="#7d7c7c" />
                        <Label
                            x:Name="GastosLabel"
                            FontAttributes="Bold"
                            FontSize="14"
                            HorizontalOptions="Center"
                            TextColor="#6e0a24" />
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <!--  Sección Ganancias  -->
            <Frame
                Padding="16"
                BackgroundColor="#2a2a2a"
                CornerRadius="17"
                HasShadow="True">
                <VerticalStackLayout Spacing="5">
                    <Label
                        FontSize="14"
                        HorizontalOptions="Center"
                        Text="GANANCIAS TOTALES"
                        TextColor="#7d7c7c" />
                    <Label
                        x:Name="GananciasLabel"
                        FontAttributes="Bold"
                        FontSize="18"
                        HorizontalOptions="Center"
                        TextColor="#1f6bc2" />
                </VerticalStackLayout>
            </Frame>

            <!--  Selector de Período  -->
            <Frame
                Padding="4"
                BackgroundColor="#2a2a2a"
                CornerRadius="17"
                HasShadow="True">
                <Picker
                    x:Name="PeriodSelector"
                    Title="Seleccionar período de análisis"
                    SelectedIndexChanged="PeriodSelector_OnSelectedIndexChanged"
                    TextColor="#FFFFFF"
                    TitleColor="#7c7c7c"
                    FontSize="16">
                    <Picker.Items>
                        <x:String>Días</x:String>
                        <x:String>Semanas</x:String>
                        <x:String>Meses</x:String>
                    </Picker.Items>
                </Picker>
            </Frame>

            <!--  SECCIÓN VENTAS COMPLETA  -->
            <Frame
                Padding="20"
                BackgroundColor="#2a2a2a"
                CornerRadius="17"
                HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <!-- Encabezado de Ventas -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            HorizontalOptions="Center"
                            Text="📈 ANÁLISIS DE VENTAS"
                            TextColor="#2e9449" />
                        <BoxView
                            HeightRequest="2"
                            BackgroundColor="#2e9449"
                            HorizontalOptions="Fill"
                            Opacity="0.6" />
                    </VerticalStackLayout>

                    <!-- Resumen de Ventas -->
                    <HorizontalStackLayout 
                        HorizontalOptions="Center" 
                        Spacing="20">
                        <VerticalStackLayout Spacing="3">
                            <Label
                                Text="TOTAL PERÍODO"
                                FontSize="12"
                                TextColor="#7d7c7c"
                                HorizontalOptions="Center" />
                            <Label
                                x:Name="VentasPeriodoLabel"
                                FontAttributes="Bold"
                                FontSize="16"
                                TextColor="#2e9449"
                                HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Gráfico de Ventas -->
                    <microcharts:ChartView
                        x:Name="VentasChart"
                        BackgroundColor="#2a2a2a"
                        HeightRequest="220" />
                </VerticalStackLayout>
            </Frame>

            <!--  SECCIÓN GASTOS COMPLETA  -->
            <Frame
                Padding="20"
                BackgroundColor="#2a2a2a"
                CornerRadius="17"
                HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <!-- Encabezado de Gastos -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            HorizontalOptions="Center"
                            Text="📉 ANÁLISIS DE GASTOS"
                            TextColor="#d63384" />
                        <BoxView
                            HeightRequest="2"
                            BackgroundColor="#d63384"
                            HorizontalOptions="Fill"
                            Opacity="0.6" />
                    </VerticalStackLayout>

                    <!-- Resumen de Gastos -->
                    <HorizontalStackLayout 
                        HorizontalOptions="Center" 
                        Spacing="20">
                        <VerticalStackLayout Spacing="3">
                            <Label
                                Text="TOTAL PERÍODO"
                                FontSize="12"
                                TextColor="#7d7c7c"
                                HorizontalOptions="Center" />
                            <Label
                                x:Name="GastosPeriodoLabel"
                                FontAttributes="Bold"
                                FontSize="16"
                                TextColor="#d63384"
                                HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Gráfico de Gastos -->
                    <microcharts:ChartView
                        x:Name="GastosChart"
                        BackgroundColor="#2a2a2a"
                        HeightRequest="220" />
                </VerticalStackLayout>
            </Frame>

            <!--  SECCIÓN GANANCIAS COMPLETA  -->
            <Frame
                Padding="20"
                BackgroundColor="#2a2a2a"
                CornerRadius="17"
                HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <!-- Encabezado de Ganancias -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            HorizontalOptions="Center"
                            Text="💰 ANÁLISIS DE GANANCIAS"
                            TextColor="#1f6bc2" />
                        <BoxView
                            HeightRequest="2"
                            BackgroundColor="#1f6bc2"
                            HorizontalOptions="Fill"
                            Opacity="0.6" />
                    </VerticalStackLayout>

                    <!-- Resumen de Ganancias -->
                    <HorizontalStackLayout 
                        HorizontalOptions="Center" 
                        Spacing="20">
                        <VerticalStackLayout Spacing="3">
                            <Label
                                Text="GANANCIA PERÍODO"
                                FontSize="12"
                                TextColor="#7d7c7c"
                                HorizontalOptions="Center" />
                            <Label
                                x:Name="GananciasPeriodoLabel"
                                FontAttributes="Bold"
                                FontSize="16"
                                TextColor="#1f6bc2"
                                HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="3">
                            <Label
                                Text="MARGEN %"
                                FontSize="12"
                                TextColor="#7d7c7c"
                                HorizontalOptions="Center" />
                            <Label
                                x:Name="MargenLabel"
                                FontAttributes="Bold"
                                FontSize="16"
                                TextColor="#17a2b8"
                                HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Gráfico de Ganancias -->
                    <microcharts:ChartView
                        x:Name="GananciasChart"
                        BackgroundColor="#2a2a2a"
                        HeightRequest="220" />
                </VerticalStackLayout>
            </Frame>

            <!--  Botón Exportar  -->
            <Button
                Margin="0,20,0,0"
                BackgroundColor="#6490E9"
                Clicked="OnExportarAExcelClicked"
                CornerRadius="10"
                FontAttributes="Bold"
                HeightRequest="50"
                Text="📊 EXPORTAR REPORTE COMPLETO"
                TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
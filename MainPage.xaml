<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mercader"
    xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
    Title="Dashboard Mercader"
    BackgroundColor="#1e1e1e">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <!--  Sección Botones Principales  -->
            <HorizontalStackLayout
                Margin="0,0,0,15"
                HorizontalOptions="Center"
                Spacing="1">

                <Button
                    BackgroundColor="#1f6bc2"
                    Clicked="InAgregarEncargo"
                    CornerRadius="10"
                    Text="➕ Encargo"
                    TextColor="White"
                    WidthRequest="120" />

                <Button
                    BackgroundColor="#2e9449"
                    Clicked="InAgregarVenta"
                    CornerRadius="10"
                    Text="💰 Venta"
                    TextColor="White"
                    WidthRequest="120" />

                <Button
                    BackgroundColor="#6e0a24"
                    Clicked="InAgregarGasto"
                    CornerRadius="10"
                    Text="💸 Gasto"
                    TextColor="White"
                    WidthRequest="120" />
            </HorizontalStackLayout>

            <!--  Sección 1 Resumen Financiero  -->
            <Frame
                Padding="16"
                BackgroundColor="#2a2a2a"
                CornerRadius="17"
                HasShadow="True">

                <Grid ColumnSpacing="15" RowSpacing="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Encargos  -->
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label
                            FontSize="13"
                            HorizontalOptions="Center"
                            Text="ENCARGOS"
                            TextColor="#7d7c7c" />
                        <Label
                            x:Name="EncargosLabel"
                            FontAttributes="Bold"
                            FontSize="14"
                            HorizontalOptions="Center"
                            TextColor="#1f6bc2" />
                    </VerticalStackLayout>

                    <!--  Ventas  -->
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label
                            FontSize="13"
                            HorizontalOptions="Center"
                            Text="VENTAS"
                            TextColor="#7d7c7c" />
                        <Label
                            x:Name="VentasLabel"
                            FontAttributes="Bold"
                            FontSize="14"
                            HorizontalOptions="Center"
                            TextColor="#2e9449" />
                    </VerticalStackLayout>

                    <!--  Gastos  -->
                    <VerticalStackLayout Grid.Column="2" Spacing="5">
                        <Label
                            FontSize="13"
                            HorizontalOptions="Center"
                            Text="GASTOS"
                            TextColor="#7d7c7c" />
                        <Label
                            x:Name="GastosLabel"
                            FontAttributes="Bold"
                            FontSize="14"
                            HorizontalOptions="Center"
                            TextColor="#6e0a24" />
                    </VerticalStackLayout>


                </Grid>
            </Frame>

            <!--  Sección 2 Resumen Financiero  -->
            <Frame
                Padding="16"
                BackgroundColor="#2a2a2a"
                CornerRadius="17"
                HasShadow="True">

                <Grid ColumnSpacing="15" RowSpacing="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>
                    <!--  Ganancias  -->
                    <VerticalStackLayout Grid.Column="3" Spacing="5">
                        <Label
                            FontSize="14"
                            HorizontalOptions="Center"
                            Text="GANANCIAS"
                            TextColor="#7d7c7c" />
                        <Label
                            x:Name="GananciasLabel"
                            FontAttributes="Bold"
                            FontSize="16"
                            HorizontalOptions="Center"
                            TextColor="#1f6bc2" />
                    </VerticalStackLayout>
                </Grid>
            </Frame>


            <Frame
                Padding="4"
                BackgroundColor="#2a2a2a"
                CornerRadius="17"
                HasShadow="True">
                <Picker
                    x:Name="PeriodSelector"
                    Title="Seleccionar período"
                    SelectedIndexChanged="PeriodSelector_OnSelectedIndexChanged"
                    TextColor="#7f7c7c"
                    TitleColor="#7c7c7c">
                    <Picker.Items>
                        <x:String>Días</x:String>
                        <x:String>Semanas</x:String>
                        <x:String>Meses</x:String>
                    </Picker.Items>
                </Picker>
            </Frame>


            <!--  Gráfico de Ventas  -->
            <Label
                x:Name="VentasChartLabel"
                FontAttributes="Bold"
                FontSize="16"
                HorizontalOptions="Center"
                Text="VENTAS"
                TextColor="#2e9449" />

            <Frame
                Padding="16"
                BackgroundColor="#2a2a2a"
                CornerRadius="17"
                HasShadow="False">
                <microcharts:ChartView
                    x:Name="VentasChart"
                    Grid.Row="3"
                    Margin="0,0,0,10"
                    BackgroundColor="#2a2a2a"
                    HeightRequest="200" />
            </Frame>

            <!--  Gráfico de Gastos  -->
            <Label
                x:Name="GastosChartLabel"
                FontAttributes="Bold"
                FontSize="16"
                HorizontalOptions="Center"
                Text="GASTOS"
                TextColor="#6e0a24" />

            <Frame
                Padding="16"
                BackgroundColor="#2a2a2a"
                CornerRadius="15"
                HasShadow="False">
                <microcharts:ChartView
                    x:Name="GastosChart"
                    Grid.Row="5"
                    Margin="0,0,0,10"
                    BackgroundColor="#2a2a2a"
                    HeightRequest="200" />
            </Frame>

            <!--  Gráfico de Ganancias  -->
            <Label
                x:Name="GananciasChartLabel"
                FontAttributes="Bold"
                FontSize="16"
                HorizontalOptions="Center"
                Text="GANANCIAS NETAS"
                TextColor="#1f6bc2" />

            <!--  Gráfico de Ganancias  -->
            <Frame
                Padding="16"
                BackgroundColor="#2a2a2a"
                CornerRadius="15"
                HasShadow="False">
                <microcharts:ChartView
                    x:Name="GananciasChart"
                    Grid.Row="7"
                    BackgroundColor="#2a2a2a"
                    HeightRequest="200" />
            </Frame>


            <!--  Botón Exportar  -->
            <Button
                Margin="0,20,0,0"
                BackgroundColor="#6490E9"
                Clicked="OnExportarAExcelClicked"
                CornerRadius="10"
                FontAttributes="Bold"
                HeightRequest="50"
                Text="📊 EXPORTAR A EXCEL"
                TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
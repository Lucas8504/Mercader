<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mercader"
    xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
    Title="🏠 Inicio"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <!--  Sección Botones Principales  -->
            <HorizontalStackLayout
                Margin="-5,0,0,0"
                HorizontalOptions="Center"
                Spacing="7">


                <Button
                    BackgroundColor="{StaticResource GastoColor}"
                    Clicked="InAgregarGasto"
                    CornerRadius="17"
                    Text="➕​ Gasto"
                    TextColor="White"
                    WidthRequest="106" />

                <Button
                    BackgroundColor="{StaticResource EncargoColor}"
                    Clicked="InAgregarEncargo"
                    CornerRadius="17"
                    Text="➕ ​Encargo"
                    TextColor="White"
                    WidthRequest="106" />

                <Button
                    BackgroundColor="{StaticResource VentaColor}"
                    Clicked="InAgregarVenta"
                    CornerRadius="17"
                    Text="➕​ Venta"
                    TextColor="White"
                    WidthRequest="106" />


            </HorizontalStackLayout>


            <!--  Selector de Período  -->
            <Frame
                Padding="4"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="17"
                HasShadow="True">
                <Picker
                    ItemsSource="{Binding Periodos}"
                    Title="Seleccionar período de análisis"
                    SelectedItem="{Binding PeriodoSeleccionado, Mode=Default}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    TitleColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                    FontSize="16">
                    <Picker.Items>
                        <x:String>Días</x:String>
                        <x:String>Semanas</x:String>
                        <x:String>Meses</x:String>
                    </Picker.Items>
                </Picker>
            </Frame>

            <!-- Línea separadora -->
            <BoxView
                HeightRequest="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardBackgroundDark}}"
                HorizontalOptions="Fill" />

            <!--  SECCIÓN GASTOS COMPLETA  -->
            <Frame Padding="20" BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}" CornerRadius="12" HasShadow="True">

                <Grid RowDefinitions="Auto, *" RowSpacing="15">

                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">

                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <Label Text="💸 ANÁLISIS DE GASTOS"
                                   FontAttributes="Bold" FontSize="16" TextColor="#6e0a24" />

                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End" Spacing="0">
                            <Label Text="TOTAL PERÍODO" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" HorizontalOptions="End" />
                            <Label Text="{Binding TotalGastos}"
                                   FontAttributes="Bold" FontSize="18" TextColor="#6e0a24" HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Grid>

                    <ScrollView x:Name="GastosScroll" Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Always">
                        <microcharts:ChartView
                            Chart="{Binding GastosChart}"
                            BackgroundColor="Transparent"
                            HeightRequest="290"
                            WidthRequest="5950" />
                    </ScrollView>

                </Grid>
            </Frame>

            <!--  SECCIÓN ENCARGOS COMPLETA  -->
            <Frame
                Padding="15"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="12"
                HasShadow="True">

                <Grid RowDefinitions="Auto, *" RowSpacing="15">

                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">

                        <!-- Encabezado de Encargos -->
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="📦 ANÁLISIS DE ENCARGOS"
                                TextColor="#ff6b35" />

                        </VerticalStackLayout>

                        <!-- Resumen de Encargos -->

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End" Spacing="0">
                            <Label
                                Text="TOTAL PERÍODO"
                                FontSize="10"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                HorizontalOptions="End"/>
                            <Label
                                Text="{Binding TotalEncargos}"
                                FontAttributes="Bold"
                                FontSize="16 "
                                TextColor="#ff6b35"
                                HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Gráfico de Encargos -->
                    <ScrollView x:Name="EncargosScroll" Grid.Row="1" HorizontalScrollBarVisibility="Always" Orientation="Horizontal">
                        <microcharts:ChartView
                            Chart="{Binding EncargosChart}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                            HeightRequest="290"
                            WidthRequest="5950" />
                    </ScrollView>

                </Grid>
            </Frame>

            <!--  SECCIÓN VENTAS COMPLETA  -->
            <Frame
                Padding="15"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="12"
                HasShadow="True">

                <Grid RowDefinitions="Auto, *" RowSpacing="15">

                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">


                        <!-- Encabezado de Ventas -->
                        <VerticalStackLayout  Grid.Column="0" VerticalOptions="Center"  Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                HorizontalOptions="Start"
                                Text="💵​ ANÁLISIS DE VENTAS"
                                TextColor="#2e9449" />

                        </VerticalStackLayout>

                        <!-- Resumen de Ventas -->

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End" Spacing="0">
                            <Label
                                Text="TOTAL PERÍODO"
                                FontSize="10"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                HorizontalOptions="End" />
                            <Label
                                Text="{Binding TotalVentas}"
                                FontAttributes="Bold"
                                FontSize="16"
                                TextColor="#2e9449"
                                HorizontalOptions="End" />
                        </VerticalStackLayout>


                    </Grid>

                    <!-- Gráfico de Ventas -->

                    <ScrollView x:Name="VentasScroll" Grid.Row="1" HorizontalScrollBarVisibility="Always" Orientation="Horizontal">
                        <microcharts:ChartView
                            Chart="{Binding VentasChart}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                            HeightRequest="290"
                            WidthRequest="5950"/>
                    </ScrollView>

                </Grid>
            </Frame>

            <!--  SECCIÓN GANANCIAS COMPLETA  -->
            <Frame
                Padding="18"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="12"
                HasShadow="True">

                <Grid RowDefinitions="Auto, *" RowSpacing="15">

                    <!-- ===== ENCABEZADO ===== -->
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*, Auto"
                          ColumnSpacing="15">

                        <!-- Título -->
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label
                                Text="💰 ANÁLISIS DE GANANCIAS"
                                VerticalTextAlignment="End"
                                FontAttributes="Bold"
                                FontSize="15"
                                TextColor="#1f6bc2" />
                        </VerticalStackLayout>

                        <!-- Totales -->
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="2"
                                             HorizontalOptions="End">

                            <VerticalStackLayout Spacing="1">
                                <Label
                                    Text="TOTAL PERÍODO"
                                    FontSize="9"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                    HorizontalTextAlignment="End" />
                                <Label
                                    Text="{Binding Ganancias}"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    TextColor="#1f6bc2"
                                    HorizontalTextAlignment="End" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="1">
                                <Label
                                    Text="MARGEN DE GANANCIAS"
                                    FontSize="9"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                    HorizontalTextAlignment="End" />
                                <Label
                                    Text="{Binding Margen}"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    TextColor="#17a2b8"
                                    HorizontalTextAlignment="End" />
                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Grid>

                    <!-- ===== GRÁFICO ===== -->
                    <ScrollView Grid.Row="1"
                                x:Name="GananciasScroll"
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Always">

                        <microcharts:ChartView
                            Chart="{Binding GananciasChart}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                            HeightRequest="290"
                            WidthRequest="5950" />

                    </ScrollView>

                </Grid>
            </Frame>


            <!-- Línea separadora -->
            <BoxView
                HeightRequest="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardBackgroundDark}}"
                HorizontalOptions="Fill" />

            <!--  Botón Exportar  -->
            <Button
                Margin="10,1,0,0"
                BackgroundColor="{StaticResource ExportarColor}"
                Clicked="OnExportarAExcelClicked"
                CornerRadius="17"
                FontAttributes="Bold"
                HeightRequest="50"
                Text="📊 EXPORTAR REPORTE COMPLETO"
                TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
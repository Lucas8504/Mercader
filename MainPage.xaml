<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mercader"
    xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
    Title="🏠 Inicio"
    BackgroundColor="{StaticResource MainPageBackground}">

    <!-- Contenedor principal con scroll vertical -->
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <!-- ============================================
            SECCIÓN 1: BOTONES DE ACCIÓN RÁPIDA
            ============================================
            Botones para agregar rápidamente:
            - Gasto: Registrar un nuevo gasto
            - Encargo: Registrar un nuevo encargo
            - Venta: Registrar una nueva venta
            -->
            <HorizontalStackLayout
                Margin="-5,0,0,0"
                HorizontalOptions="Center"
                Spacing="7">

                <Button
                    Style="{StaticResource GastoButtonStyle}"
                    Clicked="InAgregarGasto"
                    Text="➕​ Gasto" />

                <Button
                    Style="{StaticResource EncargoButtonStyle}"
                    Clicked="InAgregarEncargo"
                    Text="➕ ​Encargo" />

                <Button
                    Style="{StaticResource VentaButtonStyle}"
                    Clicked="InAgregarVenta"
                    Text="➕​ Venta" />

            </HorizontalStackLayout>

            <!-- ============================================
            SECCIÓN 2: SELECTOR DE PERÍODO
            ============================================
            Permite filtrar los datos mostrados en los
            gráficos por:
            - Días: Últimos 7-30 días
            - Semanas: Últimas 4-12 semanas
            - Meses: Últimos 6-12 meses
            -->
            <Frame Style="{StaticResource PickerFrameStyle}">
                <Picker
                    Style="{StaticResource PeriodPickerStyle}"
                    ItemsSource="{Binding Periodos}"
                    Title="Seleccionar período de análisis"
                    SelectedItem="{Binding PeriodoSeleccionado, Mode=Default}">
                    <Picker.Items>
                        <x:String>Días</x:String>
                        <x:String>Semanas</x:String>
                        <x:String>Meses</x:String>
                    </Picker.Items>
                </Picker>
            </Frame>

            <!-- Línea separadora visual -->
            <BoxView Style="{StaticResource SeparatorStyle}" />

            <!-- ============================================
            SECCIÓN 3: ANÁLISIS DE GASTOS
            ============================================
            Muestra:
            - Título: "ANÁLISIS DE GASTOS"
            - Total de gastos en el período seleccionado
            - Gráfico visual de gastos (scrollable)

            Binding: TotalGastos, GastosChart
            -->
            <Frame Style="{StaticResource CardFrameStyle}" Padding="20">
                <Grid RowDefinitions="Auto, *" RowSpacing="15">
                    <!-- Encabezado: Título + Total -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <Label Style="{StaticResource SectionTitleStyle}" TextColor="{StaticResource GastosColor}" Text="💸 ANÁLISIS DE GASTOS" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End" Spacing="0">
                            <Label Style="{StaticResource TotalLabelStyle}" Text="TOTAL PERÍODO" />
                            <Label Style="{StaticResource LargeTotalValueStyle}" TextColor="{StaticResource GastosColor}" Text="{Binding TotalGastos}" />
                        </VerticalStackLayout>
                    </Grid>
                    <!-- Gráfico de gastos (scroll horizontal para muchos datos) -->
                    <ScrollView x:Name="GastosScroll" Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
                        <microcharts:ChartView Chart="{Binding GastosChart}" BackgroundColor="Transparent" HeightRequest="290" WidthRequest="5950" />
                    </ScrollView>
                </Grid>
            </Frame>

            <!-- ============================================
            SECCIÓN 4: ANÁLISIS DE ENCARGOS
            ============================================
            Muestra:
            - Título: "ANÁLISIS DE ENCARGOS"
            - Total de encargos en el período seleccionado
            - Gráfico visual de encargos (scrollable)

            Binding: TotalEncargos, EncargosChart
            -->
            <Frame Style="{StaticResource CardFrameStyle}" Padding="15">
                <Grid RowDefinitions="Auto, *" RowSpacing="15">
                    <!-- Encabezado: Título + Total -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <Label Style="{StaticResource SectionTitleStyle}" TextColor="{StaticResource EncargosColor}" Text="📦 ANÁLISIS DE ENCARGOS" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End" Spacing="0">
                            <Label Style="{StaticResource TotalLabelStyle}" Text="TOTAL PERÍODO" />
                            <Label Style="{StaticResource MediumTotalValueStyle}" TextColor="{StaticResource EncargosColor}" Text="{Binding TotalEncargos}" />
                        </VerticalStackLayout>
                    </Grid>
                    <!-- Gráfico de encargos (scroll horizontal para muchos datos) -->
                    <ScrollView x:Name="EncargosScroll" Grid.Row="1" HorizontalScrollBarVisibility="Always" Orientation="Horizontal">
                        <microcharts:ChartView Chart="{Binding EncargosChart}" BackgroundColor="{StaticResource CardBackground}" HeightRequest="290" WidthRequest="5950" />
                    </ScrollView>
                </Grid>
            </Frame>

            <!-- ============================================
            SECCIÓN 5: ANÁLISIS DE VENTAS
            ============================================
            Muestra:
            - Título: "ANÁLISIS DE VENTAS"
            - Total de ventas en el período seleccionado
            - Gráfico visual de ventas (scrollable)

            Binding: TotalVentas, VentasChart
            -->
            <Frame Style="{StaticResource CardFrameStyle}" Padding="15">
                <Grid RowDefinitions="Auto, *" RowSpacing="15">
                    <!-- Encabezado: Título + Total -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <Label Style="{StaticResource SectionTitleStyle}" TextColor="{StaticResource VentasColor}" Text="💵​ ANÁLISIS DE VENTAS" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End" Spacing="0">
                            <Label Style="{StaticResource TotalLabelStyle}" Text="TOTAL PERÍODO" />
                            <Label Style="{StaticResource MediumTotalValueStyle}" TextColor="{StaticResource VentasColor}" Text="{Binding TotalVentas}" />
                        </VerticalStackLayout>
                    </Grid>
                    <!-- Gráfico de ventas (scroll horizontal para muchos datos) -->
                    <ScrollView x:Name="VentasScroll" Grid.Row="1" HorizontalScrollBarVisibility="Always" Orientation="Horizontal">
                        <microcharts:ChartView Chart="{Binding VentasChart}" BackgroundColor="{StaticResource CardBackground}" HeightRequest="290" WidthRequest="5950" />
                    </ScrollView>
                </Grid>
            </Frame>

            <!-- ============================================
            SECCIÓN 6: ANÁLISIS DE GANANCIAS
            ============================================
            Muestra:
            - Título: "ANÁLISIS DE GANANCIAS"
            - Total de ganancias (Ventas - Gastos)
            - Margen de ganancias (porcentaje)
            - Gráfico visual de ganancias (scrollable)

            Binding: Ganancias, Margen, GananciasChart
            -->
            <Frame Style="{StaticResource CardFrameStyle}" Padding="18">
                <Grid RowDefinitions="Auto, *" RowSpacing="15">
                    <!-- Encabezado: Título + Totales -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Style="{StaticResource SectionTitleStyle}" FontSize="15" TextColor="{StaticResource GananciasColor}" Text="💰 ANÁLISIS DE GANANCIAS" VerticalTextAlignment="End" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                            <!-- Total de ganancias -->
                            <VerticalStackLayout Spacing="1">
                                <Label Style="{StaticResource TotalLabelStyle}" Text="TOTAL PERÍODO" />
                                <Label Style="{StaticResource MediumTotalValueStyle}" TextColor="{StaticResource GananciasColor}" Text="{Binding Ganancias}" />
                            </VerticalStackLayout>
                            <!-- Margen de ganancias -->
                            <VerticalStackLayout Spacing="1">
                                <Label Style="{StaticResource TotalLabelStyle}" Text="MARGEN DE GANANCIAS" />
                                <Label Style="{StaticResource SmallTotalValueStyle}" TextColor="{StaticResource MargenColor}" Text="{Binding Margen}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                    <!-- Gráfico de ganancias (scroll horizontal para muchos datos) -->
                    <ScrollView Grid.Row="1" x:Name="GananciasScroll" Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
                        <microcharts:ChartView Chart="{Binding GananciasChart}" BackgroundColor="{StaticResource CardBackground}" HeightRequest="290" WidthRequest="5950" />
                    </ScrollView>
                </Grid>
            </Frame>

            <!-- Línea separadora visual -->
            <BoxView Style="{StaticResource SeparatorStyle}" />

            <!-- ============================================
            SECCIÓN 7: BOTÓN EXPORTAR
            ============================================
            Genera y exporta un reporte completo en Excel
            con todos los datos del período seleccionado.

            Evento: OnExportarAExcelClicked
            -->
            <Button
                Style="{StaticResource ExportarButtonStyle}"
                Margin="10,1,0,0"
                Clicked="OnExportarAExcelClicked"
                Text="📊 EXPORTAR REPORTE COMPLETO" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

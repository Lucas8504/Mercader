<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mercader"
    xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
    Title="🏠 Inicio"
    BackgroundColor="#1C1C1C">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <!--  Sección Botones Principales  -->
            <HorizontalStackLayout
                Margin="-5,0,0,0"
                HorizontalOptions="Center"
                Spacing="7">


                <Button
                    BackgroundColor="#6e0a24"
                    Clicked="InAgregarGasto"
                    CornerRadius="17"
                    Text="➕​ Gasto"
                    TextColor="White"
                    WidthRequest="106" />

                <Button
                    BackgroundColor="#ff6b35"
                    Clicked="InAgregarEncargo"
                    CornerRadius="17"
                    Text="➕ ​Encargo"
                    TextColor="White"
                    WidthRequest="106" />

                <Button
                    BackgroundColor="#2e9449"
                    Clicked="InAgregarVenta"
                    CornerRadius="17"
                    Text="➕​ Venta"
                    TextColor="White"
                    WidthRequest="106" />


            </HorizontalStackLayout>


            <!--  Selector de Período  -->
            <Frame
                Padding="4"
                BackgroundColor="#2a2a2a"
                CornerRadius="17"
                HasShadow="True">
                <Picker
                    x:Name="PeriodSelector"
                    Title="Seleccionar período de análisis"
                    SelectedIndexChanged="PeriodSelector_OnSelectedIndexChanged"
                    TextColor="#FFFFFF"
                    TitleColor="#7c7c7c"
                    FontSize="16">
                    <Picker.Items>
                        <x:String>Días</x:String>
                        <x:String>Semanas</x:String>
                        <x:String>Meses</x:String>
                    </Picker.Items>
                </Picker>
            </Frame>

            <!-- Línea separadora -->
            <BoxView
                HeightRequest="1"
                BackgroundColor="#333333"
                HorizontalOptions="Fill" />

            <!--  SECCIÓN GASTOS COMPLETA  -->
            <Frame Padding="15" BackgroundColor="#2a2a2a" CornerRadius="12" HasShadow="True">

                <Grid RowDefinitions="Auto, *" RowSpacing="15">

                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">

                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <Label Text="💸 ANÁLISIS DE GASTOS"
                                   FontAttributes="Bold" FontSize="16" TextColor="#d63384" />
                            <BoxView HeightRequest="2" Color="#d63384" Opacity="0.6"
                                     WidthRequest="190" HorizontalOptions="Start" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End" Spacing="0">
                            <Label Text="TOTAL PERÍODO" FontSize="10" TextColor="#7d7c7c" HorizontalOptions="End" />
                            <Label x:Name="GastosPeriodoLabel"
                                   Text="$ 0.00"
                                   FontAttributes="Bold" FontSize="18" TextColor="#d63384" HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Grid>

                    <ScrollView Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">
                        <microcharts:ChartView
                            x:Name="GastosChart"
                            BackgroundColor="Transparent"
                            HeightRequest="220"
                            WidthRequest="600" />
                    </ScrollView>

                </Grid>
            </Frame>

            <!--  SECCIÓN ENCARGOS COMPLETA  -->
            <Frame
                Padding="20"
                BackgroundColor="#2a2a2a"
                CornerRadius="12"
                HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <!-- Encabezado de Encargos -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            HorizontalOptions="Center"
                            Text="📦 ANÁLISIS DE ENCARGOS"
                            TextColor="#ff6b35" />
                        <BoxView
                            HeightRequest="2"
                            BackgroundColor="#ff6b35"
                            HorizontalOptions="Fill"
                            Opacity="0.6" />
                    </VerticalStackLayout>

                    <!-- Resumen de Encargos -->
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="20">
                        <VerticalStackLayout Spacing="3">
                            <Label
                                Text="TOTAL PERÍODO"
                                FontSize="12"
                                TextColor="#7d7c7c"
                                HorizontalOptions="Center" />
                            <Label
                                x:Name="EncargosPeriodoLabel"
                                FontAttributes="Bold"
                                FontSize="16"
                                TextColor="#ff6b35"
                                HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Gráfico de Encargos -->
                    <microcharts:ChartView
                        x:Name="EncargosChart"
                        BackgroundColor="#2a2a2a"
                        HeightRequest="220" />
                </VerticalStackLayout>
            </Frame>

            <!--  SECCIÓN VENTAS COMPLETA  -->
            <Frame
                Padding="20"
                BackgroundColor="#2a2a2a"
                CornerRadius="12"
                HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <!-- Encabezado de Ventas -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            HorizontalOptions="Center"
                            Text="💵​ ANÁLISIS DE VENTAS"
                            TextColor="#2e9449" />
                        <BoxView
                            HeightRequest="2"
                            BackgroundColor="#2e9449"
                            HorizontalOptions="Fill"
                            Opacity="0.6" />
                    </VerticalStackLayout>

                    <!-- Resumen de Ventas -->
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="20">
                        <VerticalStackLayout Spacing="3">
                            <Label
                                Text="TOTAL PERÍODO"
                                FontSize="12"
                                TextColor="#7d7c7c"
                                HorizontalOptions="Center" />
                            <Label
                                x:Name="VentasPeriodoLabel"
                                FontAttributes="Bold"
                                FontSize="16"
                                TextColor="#2e9449"
                                HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Gráfico de Ventas -->
                    <microcharts:ChartView
                        x:Name="VentasChart"
                        BackgroundColor="#2a2a2a"
                        HeightRequest="220" />
                </VerticalStackLayout>
            </Frame>

            <!--  SECCIÓN GANANCIAS COMPLETA  -->
            <Frame
                Padding="20"
                BackgroundColor="#2a2a2a"
                CornerRadius="12"
                HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <!-- Encabezado de Ganancias -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            HorizontalOptions="Center"
                            Text="💰 ANÁLISIS DE GANANCIAS"
                            TextColor="#1f6bc2" />
                        <BoxView
                            HeightRequest="2"
                            BackgroundColor="#1f6bc2"
                            HorizontalOptions="Fill"
                            Opacity="0.6" />
                    </VerticalStackLayout>

                    <!-- Resumen de Ganancias -->
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="20">
                        <VerticalStackLayout Spacing="3">
                            <Label
                                Text="GANANCIA PERÍODO"
                                FontSize="12"
                                TextColor="#7d7c7c"
                                HorizontalOptions="Center" />
                            <Label
                                x:Name="GananciasPeriodoLabel"
                                FontAttributes="Bold"
                                FontSize="16"
                                TextColor="#1f6bc2"
                                HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="3">
                            <Label
                                Text="MARGEN %"
                                FontSize="12"
                                TextColor="#7d7c7c"
                                HorizontalOptions="Center" />
                            <Label
                                x:Name="MargenLabel"
                                FontAttributes="Bold"
                                FontSize="16"
                                TextColor="#17a2b8"
                                HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Gráfico de Ganancias -->
                    <microcharts:ChartView
                        x:Name="GananciasChart"
                        BackgroundColor="#2a2a2a"
                        HeightRequest="220" />
                </VerticalStackLayout>
            </Frame>

            <!-- Línea separadora -->
            <BoxView
                HeightRequest="1"
                BackgroundColor="#333333"
                HorizontalOptions="Fill" />

            <!--  Botón Exportar  -->
            <Button
                Margin="10,1,0,0"
                BackgroundColor="#6490E9"
                Clicked="OnExportarAExcelClicked"
                CornerRadius="17"
                FontAttributes="Bold"
                HeightRequest="50"
                Text="📊 EXPORTAR REPORTE COMPLETO"
                TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
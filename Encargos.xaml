<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.Encargos"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Encargos">
    <StackLayout
        Margin="10"
        Padding="10"
        Spacing="20">

        <Label
            HorizontalOptions="Center"
            Text="Encargos"
            VerticalOptions="Center" />

        <!-- Encabezados de las columnas -->
        <Grid Padding="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Text="Nombre" FontAttributes="Bold"/>
            <Label Grid.Column="1" Text="Descripción" FontAttributes="Bold" />
            <Label Grid.Column="2" Text="Precio" FontAttributes="Bold" />
            <Label Grid.Column="3" Text="Cantidad" FontAttributes="Bold" />
            <Label Grid.Column="4" Text="Fecha" FontAttributes="Bold" />
        </Grid>

        <CollectionView x:Name="EncargosCollectionView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Text="{Binding Nombre}" TextColor="Coral" />
                        <Label Grid.Column="1" Text="{Binding Descripcion}" TextColor="Coral" />
                        <Label Grid.Column="2" Text="{Binding Precio}" TextColor="Coral"/>
                        <Label Grid.Column="3" Text="{Binding Cantidad}" TextColor="Coral"/>
                        <Label Grid.Column="4" Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" TextColor="Coral"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


    </StackLayout>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.Encargos"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mercader"
    Title="📋 Gestión de Encargos"
    BackgroundColor="#0f0f0f">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>



        <!-- Lista de encargos -->
        <ScrollView Grid.Row="1" Margin="10,0">
            <StackLayout Spacing="12">
                <CollectionView
                    x:Name="EncargosCollectionView"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureAllItems">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <SwipeView Margin="5,2">
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItem
                                            BackgroundColor="#4CAF50"
                                            Invoked="OnEditSwipeItemInvoked"
                                            Text="✏️ Editar" />
                                        <SwipeItem
                                            BackgroundColor="#F44336"
                                            Invoked="OnDeleteSwipeItemInvoked"
                                            Text="🗑️ Eliminar" />
                                        <SwipeItem
                                            BackgroundColor="#2196F3"
                                            Invoked="OnDetallesSwipeItemInvoked"
                                            Text="👁️ Detalles" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <!-- Tarjeta de encargo mejorada con 4 filas -->
                                <Frame
                                    Padding="18"
                                    BackgroundColor="#1e1e1e"
                                    BorderColor="#333333"
                                    CornerRadius="12"
                                    HasShadow="True">

                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnItemTapped" />
                                    </Frame.GestureRecognizers>

                                    <!-- Efecto visual al tocar -->
                                    <Frame.Triggers>
                                        <Trigger TargetType="Frame" Property="IsEnabled" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </Trigger>
                                    </Frame.Triggers>

                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- PRIMERA FILA: Nombre del cliente (destacado) -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackLayout Grid.Row="0" Spacing="5">
                                                <Label
                                                    Text="👤 CLIENTE"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    TextColor="#4CAF50"
                                                    Margin="0,0,0,2" />
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="16"
                                                    LineBreakMode="WordWrap"
                                                    Text="{Binding Nombre}"
                                                    TextColor="#ffffff"
                                                    Margin="0,0,0,8" />
                                            </StackLayout>

                                            <!-- Número de contacto (clickeable) -->
                                            <StackLayout Grid.Row="0" Grid.Column="1" Spacing="5">
                                                <Label
                                                    Text="📞 CONTACTO"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    TextColor="#00BCD4"
                                                    Margin="0,0,0,2" />
                                                <Frame
                                                    Padding="12,8"
                                                    BackgroundColor="#2A222D"

                                                    CornerRadius="8"
                                                    HasShadow="False"
                                                    HorizontalOptions="Center">
                                                    <Frame.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnContactTapped" />
                                                    </Frame.GestureRecognizers>
                                                    <Label
                                                        FontAttributes="None"
                                                        FontSize="14"
                                                        Text="{Binding Contacto}"
                                                        TextColor="#00BCD4"
                                                        HorizontalTextAlignment="Center" />
                                                </Frame>
                                            </StackLayout>

                                        </Grid>

                                        <!-- Línea separadora -->
                                        <BoxView Grid.Row="1"
                                                 HeightRequest="1"
                                                 BackgroundColor="#333333"
                                                 HorizontalOptions="Fill" />

                                        <!-- SEGUNDA FILA: Detalles (Precio y Cantidad) -->
                                        <Grid Grid.Row="2" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Precio -->
                                            <StackLayout Grid.Column="0" Spacing="5">
                                                <Label
                                                    Text="💰 PRECIO"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="#2196F3"
                                                    HorizontalTextAlignment="Start" />
                                                <Frame
                                                    Padding="8,4"
                                                    BackgroundColor="#2196F3"
                                                    BorderColor="#1976D2"
                                                    CornerRadius="8"
                                                    HasShadow="False"
                                                    HorizontalOptions="Start">
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="14"
                                                        Text="{Binding Precio, StringFormat='${0:F2}'}"
                                                        TextColor="#ffffff"
                                                        HorizontalTextAlignment="Start" />
                                                </Frame>
                                            </StackLayout>

                                            <!-- Cantidad -->
                                            <StackLayout Grid.Column="1" Spacing="5">
                                                <Label
                                                    Text="📦 CANTIDAD"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="#FF9800"
                                                    HorizontalTextAlignment="Center" />
                                                <Frame
                                                    Padding="8,4"
                                                    BackgroundColor="#FF9800"
                                                    BorderColor="#F57C00"
                                                    CornerRadius="6"
                                                    HasShadow="False"
                                                    HorizontalOptions="Center">
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="14"
                                                        Text="{Binding Cantidad}"
                                                        TextColor="#ffffff"
                                                        HorizontalTextAlignment="Start" />
                                                </Frame>
                                            </StackLayout>
                                        </Grid>

                                        <!-- TERCER FILA: Fechas (Pedido y Entrega) -->
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Fecha de Pedido -->
                                            <StackLayout Grid.Column="0" Spacing="5">
                                                <Label
                                                    Text="📅 PEDIDO"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="#9C27B0"
                                                    HorizontalTextAlignment="Start" />
                                                <StackLayout Spacing="3" HorizontalOptions="Start">
                                                    <Frame
                                                        Padding="8,4"
                                                        BackgroundColor="#9C27B0"
                                                        BorderColor="#7B1FA2"
                                                        CornerRadius="6"
                                                        HasShadow="False">
                                                        <Label
                                                            FontSize="14"
                                                            FontAttributes="Bold"
                                                            Text="{Binding Fecha, StringFormat='{0:dd/MM/yy}'}"
                                                            TextColor="#ffffff"
                                                            HorizontalTextAlignment="Start" />
                                                    </Frame>
                                                </StackLayout>
                                            </StackLayout>

                                            <!-- Fecha de Entrega -->
                                            <StackLayout Grid.Column="1" Spacing="5">
                                                <Label
                                                    Text="🚚 ENTREGA"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="#E91E63"
                                                    HorizontalTextAlignment="Center" />
                                                <StackLayout Spacing="3" HorizontalOptions="Center">
                                                    <Frame
                                                        Padding="8,4"
                                                        BackgroundColor="#E91E63"
                                                        BorderColor="#C2185B"
                                                        CornerRadius="6"
                                                        HasShadow="False">
                                                        <Label
                                                            FontSize="14"
                                                            FontAttributes="Bold"
                                                            Text="{Binding FechaEntrega, StringFormat='{0:dd/MM/yy}'}"
                                                            TextColor="#ffffff"
                                                            HorizontalTextAlignment="Center" />
                                                    </Frame>
                                                </StackLayout>
                                            </StackLayout>
                                        </Grid>
                                    </Grid>
                                </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- Mensaje cuando no hay encargos -->
                    <CollectionView.EmptyView>
                        <StackLayout
                            Padding="20"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Spacing="15">

                            <Label
                                FontSize="48"
                                Text="📋"
                                HorizontalTextAlignment="Center" />

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="No hay encargos registrados"
                                TextColor="#cccccc"
                                HorizontalTextAlignment="Center" />

                            <Label
                                FontSize="14"
                                Text="Los encargos aparecerán aquí cuando se registren"
                                TextColor="#888888"
                                HorizontalTextAlignment="Center" />
                        </StackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- Espaciado al final -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent" />
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
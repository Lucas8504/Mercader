<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.Encargos"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mercader"
    Title="📋 Gestión de Encargos"
    BackgroundColor="{AppThemeBinding Light={StaticResource DeepBackground}, Dark={StaticResource DeepBackgroundDark}}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>



        <!-- Lista de encargos -->
        <ScrollView Grid.Row="1" Margin="10,0">
            <StackLayout Spacing="12">
                <CollectionView
                    x:Name="EncargosCollectionView"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureAllItems">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <SwipeView Margin="5,2">
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItem
                                            BackgroundColor="#4CAF50"
                                            Invoked="OnEditSwipeItemInvoked"
                                            Text="✏️ Editar" />
                                        <SwipeItem
                                            BackgroundColor="#F44336"
                                            Invoked="OnDeleteSwipeItemInvoked"
                                            Text="🗑️ Eliminar" />
                                        <SwipeItem
                                            BackgroundColor="#2196F3"
                                            Invoked="OnDetallesSwipeItemInvoked"
                                            Text="👁️ Detalles" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <!-- Tarjeta de encargo minimalista moderna -->
                                <Frame
                                    Padding="16"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                                    BorderColor="Transparent"
                                    CornerRadius="16"
                                    HasShadow="False">

                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnItemTapped" />
                                    </Frame.GestureRecognizers>

                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Fila 1: Nombre y Contacto -->
                                        <Grid Grid.Row="0" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Nombre del cliente -->
                                            <Label
                                                Grid.Column="0"
                                                FontAttributes="Bold"
                                                FontSize="17"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding Nombre}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                VerticalOptions="Center" />

                                            <!-- Contacto con touch -->
                                            <Frame
                                                Grid.Column="1"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackground}, Dark={StaticResource InputBackgroundDark}}"
                                                BorderColor="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}"
                                                CornerRadius="8"
                                                Padding="10,6"
                                                HasShadow="False">
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnContactTapped" />
                                                </Frame.GestureRecognizers>
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label
                                                        FontSize="12"
                                                        Text="📞"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        FontSize="12"
                                                        Text="{Binding Contacto}"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextSecondaryDark}}"
                                                        VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Frame>
                                        </Grid>

                                        <!-- Fila 2: Descripción y Cantidad -->
                                        <Grid Grid.Row="1" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Descripción -->
                                            <Label
                                                Grid.Column="0"
                                                FontSize="13"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding Descripcion}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                VerticalOptions="Center" />

                                            <!-- Cantidad -->
                                            <Label
                                                Grid.Column="1"
                                                FontSize="12"
                                                Text="{Binding Cantidad, StringFormat='{0} unid.'}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                VerticalOptions="Center" />
                                        </Grid>

                                        <!-- Fila 3: Total y Precio Unitario -->
                                        <Grid Grid.Row="2" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Total del Encargo -->
                                            <Frame
                                                Grid.Column="0"
                                                BackgroundColor="#A54815"
                                                BorderColor="#E16F1B"
                                                CornerRadius="8"
                                                Padding="10"
                                                HasShadow="False">
                                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                    <Label
                                                        Text="Total"
                                                        FontSize="10"
                                                        TextColor="#B8A0D0" />
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="15"
                                                        Text="{Binding TotalFormateado}"
                                                        TextColor="#D4C4E8" />
                                                </VerticalStackLayout>
                                            </Frame>

                                            <!-- Precio Unitario -->
                                            <Frame
                                                Grid.Column="1"
                                                BackgroundColor="#1E3A5F"
                                                BorderColor="#2E5A8F"
                                                CornerRadius="8"
                                                Padding="10"
                                                HasShadow="False">
                                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                    <Label
                                                        Text="x Unidad"
                                                        FontSize="10"
                                                        TextColor="#8AA0B0" />
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="15"
                                                        Text="{Binding Precio, StringFormat='${0:N2}'}"
                                                        TextColor="#A8C8D8" />
                                                </VerticalStackLayout>
                                            </Frame>
                                        </Grid>

                                        <!-- Fila 4: Fechas -->
                                        <Grid Grid.Row="3" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Fecha de Pedido -->
                                            <Label
                                                FontSize="12"
                                                Text="{Binding Fecha, StringFormat='Pedido: {0:dd MMM}'}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                VerticalOptions="Center" />

                                            <!-- Fecha de Entrega -->
                                            <Label
                                                Grid.Column="1"
                                                FontSize="12"
                                                Text="{Binding FechaEntrega, StringFormat='Entrega: {0:dd MMM}'}"
                                                TextColor="#8A8A9A"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Grid>
                                </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- Mensaje cuando no hay encargos -->
                    <CollectionView.EmptyView>
                        <StackLayout
                            Padding="20"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Spacing="15">

                            <Label
                                FontSize="48"
                                Text="📋"
                                HorizontalTextAlignment="Center" />

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="No hay encargos registrados"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                HorizontalTextAlignment="Center" />

                            <Label
                                FontSize="14"
                                Text="Los encargos aparecerán aquí cuando se registren"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                HorizontalTextAlignment="Center" />
                        </StackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- Espaciado al final -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent" />
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
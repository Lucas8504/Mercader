<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.Encargos"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mercader"
    Title="Encargos">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:GridLengthToDoubleConverter x:Key="GridLengthToDoubleConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout
            Margin="10"
            Padding="10"
            Spacing="20">

            <Label
                HorizontalOptions="Center"
                Text="Encargos"
                VerticalOptions="Center" />

            <!--  Encabezados de las columnas  -->
            <Grid Padding="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label
                    Grid.Column="0"
                    FontAttributes="Bold"
                    Text="Nombre" />
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    Text="Descripción" />
                <Label
                    Grid.Column="2"
                    FontAttributes="Bold"
                    Text="Precio" />
                <Label
                    Grid.Column="3"
                    FontAttributes="Bold"
                    Text="Cantidad" />
                <Label
                    Grid.Column="4"
                    FontAttributes="Bold"
                    Text="Fecha" />
            </Grid>

            <CollectionView
                x:Name="EncargosCollectionView"
                SelectionChanged="OnSelectionChanged"
                SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem
                                        BackgroundColor="LightBlue"
                                        Invoked="OnEditSwipeItemInvoked"
                                        Text="Editar" />
                                    <SwipeItem
                                        BackgroundColor="LightCoral"
                                        Invoked="OnDeleteSwipeItemInvoked"
                                        Text="Eliminar" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Grid Padding="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Column="0"
                                    Text="{Binding Nombre}"
                                    TextColor="Coral" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Descripcion}"
                                    TextColor="Coral" />
                                <Label
                                    Grid.Column="2"
                                    Text="{Binding Precio}"
                                    TextColor="Coral" />
                                <Label
                                    Grid.Column="3"
                                    Text="{Binding Cantidad}"
                                    TextColor="Coral" />
                                <Label
                                    Grid.Column="4"
                                    Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                    TextColor="Coral" />
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
    </ScrollView>
</ContentPage>
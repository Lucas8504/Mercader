<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.Gastos"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mercader"
    Title="💸 Registro de Gastos"
    BackgroundColor="#0f0f0f">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!-- Lista de gastos -->
        <ScrollView Grid.Row="1" Margin="10,0">
            <StackLayout Spacing="12">
                <CollectionView
                    x:Name="GastosCollectionView"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureAllItems">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <SwipeView Margin="5,2">
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItem
                                            BackgroundColor="#4CAF50"
                                            Invoked="OnEditSwipeItemInvoked"
                                            Text="✏️ Editar" />
                                        <SwipeItem
                                            BackgroundColor="#F44336"
                                            Invoked="OnDeleteSwipeItemInvoked"
                                            Text="🗑️ Eliminar" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <!-- Tarjeta de gasto minimalista moderna -->
                                <Frame
                                    Padding="16"
                                    BackgroundColor="#252525"
                                    BorderColor="Transparent"
                                    CornerRadius="16"
                                    HasShadow="False">

                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnItemTapped" />
                                    </Frame.GestureRecognizers>

                                    <VerticalStackLayout Spacing="12">
                                        <!-- Fila 1: Descripción del gasto -->
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="17"
                                            LineBreakMode="WordWrap"
                                            Text="{Binding Descripcion}"
                                            TextColor="#E8E8E8" />

                                        <!-- Fila 2: Total y Precio Unitario en una fila -->
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Total del Gasto -->
                                            <Frame
                                                Grid.Column="0"
                                                BackgroundColor="#500023"
                                                BorderColor="#750023"
                                                CornerRadius="8"
                                                Padding="10"
                                                HasShadow="False">
                                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                    <Image
                                                        Source="wallet.png"
                                                        WidthRequest="18"
                                                        HeightRequest="18"
                                                        VerticalOptions="Center" />
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label
                                                            Text="Total"
                                                            FontSize="10"
                                                            TextColor="#9CAF88" />
                                                        <Label
                                                            FontAttributes="Bold"
                                                            FontSize="15"
                                                            Text="{Binding TotalFormateado, StringFormat='${0:N0}'}"
                                                            TextColor="#C8E6C9" />
                                                    </VerticalStackLayout>
                                                </HorizontalStackLayout>
                                            </Frame>

                                            <!-- Precio Unitario -->
                                            <Frame
                                                Grid.Column="1"
                                                BackgroundColor="#2A2A3A"
                                                BorderColor="#4A4A5A"
                                                CornerRadius="8"
                                                Padding="10"
                                                HasShadow="False">
                                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                    <Image
                                                        Source="tag.png"
                                                        WidthRequest="18"
                                                        HeightRequest="18"
                                                        VerticalOptions="Center" />
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label
                                                            Text="x Unidad"
                                                            FontSize="10"
                                                            TextColor="#8A8A9A" />
                                                        <Label
                                                            FontAttributes="Bold"
                                                            FontSize="15"
                                                            Text="{Binding Monto, StringFormat='${0:N2}'}"
                                                            TextColor="#D0D0E0" />
                                                    </VerticalStackLayout>
                                                </HorizontalStackLayout>
                                            </Frame>
                                        </Grid>

                                        <!-- Fila 3: Cantidad y Fecha -->
                                        <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <Image
                                                    Source="box.png"
                                                    WidthRequest="14"
                                                    HeightRequest="14"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    FontSize="12"
                                                    Text="{Binding Cantidad, StringFormat='{0} unid.'}"
                                                    TextColor="#888888" />
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                <Image
                                                    Source="calendar.png"
                                                    WidthRequest="12"
                                                    HeightRequest="12"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    FontSize="12"
                                                    Text="{Binding Fecha, StringFormat='{0:dd MMM yyyy}'}"
                                                    TextColor="#6A6A6A" />
                                            </HorizontalStackLayout>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- Mensaje cuando no hay gastos -->
                    <CollectionView.EmptyView>
                        <StackLayout
                            Padding="20"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Spacing="15">

                            <Label
                                FontSize="48"
                                Text="💸"
                                HorizontalTextAlignment="Center" />

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="No hay gastos registrados"
                                TextColor="#cccccc"
                                HorizontalTextAlignment="Center" />

                            <Label
                                FontSize="14"
                                Text="Los gastos aparecerán aquí cuando se registren"
                                TextColor="#888888"
                                HorizontalTextAlignment="Center" />
                        </StackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- Espaciado al final -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent" />
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
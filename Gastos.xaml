<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.Gastos"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mercader"
    Title="Gastos"
    BackgroundColor="#2a2a2a">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:GridLengthToDoubleConverter x:Key="GridLengthToDoubleConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>


    <ScrollView>
        <VerticalStackLayout>
            <Label
                FontSize="Large"
                HorizontalOptions="Center"
                Text="Lista de Gastos"
                VerticalOptions="Start" />

            <!--  Encabezados de las columnas  -->
            <Grid Padding="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label
                    Grid.Column="0"
                    Padding="2"
                    FontAttributes="Bold"
                    Text="Descripción" />
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    Text="Monto" />
                <Label
                    Grid.Column="2"
                    FontAttributes="Bold"
                    Text="Cantidad" />
                <Label
                    Grid.Column="3"
                    FontAttributes="Bold"
                    Text="Fecha" />
            </Grid>

            <CollectionView
                x:Name="GastosCollectionView"
                SelectionChanged="OnSelectionChanged"
                SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem
                                        BackgroundColor="LightBlue"
                                        Invoked="OnEditSwipeItemInvoked"
                                        Text="Editar" />
                                    <SwipeItem
                                        BackgroundColor="LightCoral"
                                        Invoked="OnDeleteSwipeItemInvoked"
                                        Text="Eliminar" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Grid Padding="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Column="0"
                                    Padding="3"
                                    Text="{Binding Descripcion}"
                                    TextColor="Coral" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Monto}"
                                    TextColor="Coral" />
                                <Label
                                    Grid.Column="2"
                                    Text="{Binding Cantidad}"
                                    TextColor="Coral" />
                                <Label
                                    Grid.Column="3"
                                    Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                    TextColor="Coral" />
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
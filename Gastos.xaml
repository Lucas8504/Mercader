<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.Gastos"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mercader"
    Title="💸 Registro de Gastos"
    BackgroundColor="#0f0f0f">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header con título y estadísticas -->
        <Frame
            Grid.Row="0"
            Margin="15,10,15,5"
            Padding="20"
            BackgroundColor="#1a1a1a"
            BorderColor="#333333"
            CornerRadius="6"
            HasShadow="True">

            <StackLayout Spacing="15">
                <!-- Título principal -->
                <Label
                    FontAttributes="Bold"
                    FontSize="24"
                    HorizontalTextAlignment="Center"
                    Text="Historial de Gastos"
                    TextColor="#ffffff" />

                <!-- Línea separadora -->
                <BoxView
                    HeightRequest="1"
                    BackgroundColor="#333333"
                    HorizontalOptions="Fill" />

                <!-- Encabezados de columnas simplificados -->
                <Grid Margin="0,5">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="📋 Desliza ← para editar o eliminar"
                        TextColor="#888888"
                        HorizontalTextAlignment="Center"
                        Margin="0,5" />
                </Grid>
            </StackLayout>
        </Frame>

        <!-- Lista de gastos -->
        <ScrollView Grid.Row="1" Margin="10,0">
            <StackLayout Spacing="12">
                <CollectionView
                    x:Name="GastosCollectionView"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureAllItems">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <SwipeView Margin="5,2">
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItem
                                            BackgroundColor="#4CAF50"
                                            Invoked="OnEditSwipeItemInvoked"
                                            Text="✏️ Editar" />
                                        <SwipeItem
                                            BackgroundColor="#F44336"
                                            Invoked="OnDeleteSwipeItemInvoked"
                                            Text="🗑️ Eliminar" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <!-- Tarjeta de gasto mejorada con 2 filas -->
                                <Frame
                                    Padding="18"
                                    BackgroundColor="#1e1e1e"
                                    BorderColor="#333333"
                                    CornerRadius="12"
                                    HasShadow="True">

                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnItemTapped" />
                                    </Frame.GestureRecognizers>

                                    <!-- Efecto visual al tocar -->
                                    <Frame.Triggers>
                                        <Trigger TargetType="Frame" Property="IsEnabled" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </Trigger>
                                    </Frame.Triggers>

                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- PRIMERA FILA: Descripción del gasto (destacada) -->
                                        <StackLayout Grid.Row="0" Spacing="5">
                                            <Label
                                                Text="💸 GASTO"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="#FF5722"
                                                Margin="0,0,0,2" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding Descripcion}"
                                                TextColor="#ffffff"
                                                Margin="0,0,0,8" />
                                        </StackLayout>

                                        <!-- SEGUNDA FILA: Detalles (Monto, Cantidad, Fecha) -->
                                        <Grid Grid.Row="1" ColumnSpacing="15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Monto -->
                                            <StackLayout Grid.Column="0" Spacing="5">
                                                <Label
                                                    Text="💰 MONTO"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="#F44336"
                                                    HorizontalTextAlignment="Center" />
                                                <Frame
                                                    Padding="10,6"
                                                    BackgroundColor="#F44336"
                                                    BorderColor="#D32F2F"
                                                    CornerRadius="8"
                                                    HasShadow="False"
                                                    HorizontalOptions="Fill">
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="14"
                                                        Text="{Binding Monto, StringFormat='${0:F2}'}"
                                                        TextColor="#ffffff"
                                                        HorizontalTextAlignment="Center" />
                                                </Frame>
                                            </StackLayout>

                                            <!-- Cantidad -->
                                            <StackLayout Grid.Column="1" Spacing="5">
                                                <Label
                                                    Text="📦 CANTIDAD"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="#FF9800"
                                                    HorizontalTextAlignment="Center" />
                                                <Frame
                                                    Padding="10,6"
                                                    BackgroundColor="#FF9800"
                                                    BorderColor="#F57C00"
                                                    CornerRadius="20"
                                                    HasShadow="False"
                                                    HorizontalOptions="Fill">
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="14"
                                                        Text="{Binding Cantidad}"
                                                        TextColor="#ffffff"
                                                        HorizontalTextAlignment="Center" />
                                                </Frame>
                                            </StackLayout>

                                            <!-- Fecha -->
                                            <StackLayout Grid.Column="2" Spacing="5">
                                                <Label
                                                    Text="📅 FECHA"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="#9C27B0"
                                                    HorizontalTextAlignment="Center" />
                                                <StackLayout Spacing="3" HorizontalOptions="Center">
                                                    <Frame
                                                        Padding="8,4"
                                                        BackgroundColor="#9C27B0"
                                                        BorderColor="#7B1FA2"
                                                        CornerRadius="6"
                                                        HasShadow="False">
                                                        <Label
                                                            FontSize="14"
                                                            FontAttributes="Bold"
                                                            Text="{Binding Fecha, StringFormat='{0:dd/MM/yy}'}"
                                                            TextColor="#ffffff"
                                                            HorizontalTextAlignment="Center" />
                                                    </Frame>
                                                    <Label
                                                        FontSize="10"
                                                        Text="{Binding Fecha, StringFormat='{0:dddd}'}"
                                                        TextColor="#888888"
                                                        HorizontalTextAlignment="Center" />
                                                </StackLayout>
                                            </StackLayout>
                                        </Grid>
                                    </Grid>
                                </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- Mensaje cuando no hay gastos -->
                    <CollectionView.EmptyView>
                        <StackLayout
                            Padding="20"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Spacing="15">

                            <Label
                                FontSize="48"
                                Text="💸"
                                HorizontalTextAlignment="Center" />

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="No hay gastos registrados"
                                TextColor="#cccccc"
                                HorizontalTextAlignment="Center" />

                            <Label
                                FontSize="14"
                                Text="Los gastos aparecerán aquí cuando se registren"
                                TextColor="#888888"
                                HorizontalTextAlignment="Center" />
                        </StackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- Espaciado al final -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent" />
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.Gastos"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mercader"
    Title="💸 Registro de Gastos"
    BackgroundColor="{AppThemeBinding Light={StaticResource DeepBackground}, Dark={StaticResource DeepBackgroundDark}}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de búsqueda -->
        <SearchBar
            Grid.Row="0"
            x:Name="BarraBusqueda"
            Placeholder="Buscar por descripción..."
            PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource InputBackground}, Dark={StaticResource InputBackgroundDark}}"
            CancelButtonColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
            FontSize="15"
            Margin="16,12,16,8"
            TextChanged="OnBusquedaTextChanged" />

        <!-- Filtros horizontales -->
        <HorizontalStackLayout
            Grid.Row="1"
            Spacing="8"
            Margin="16,0,16,12"
            HorizontalOptions="Center">

            <Frame
                x:Name="FiltroTodos"
                Padding="14,8"
                CornerRadius="20"
                BackgroundColor="{StaticResource Primary}"
                BorderColor="Transparent"
                HasShadow="False">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFiltroTapped" CommandParameter="TODOS" />
                </Frame.GestureRecognizers>
                <Label
                    Text="TODOS"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Frame>

            <Frame
                x:Name="FiltroHoy"
                Padding="14,8"
                CornerRadius="20"
                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackground}, Dark={StaticResource InputBackgroundDark}}"
                BorderColor="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}"
                HasShadow="False">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFiltroTapped" CommandParameter="HOY" />
                </Frame.GestureRecognizers>
                <Label
                    Text="HOY"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                    VerticalOptions="Center" />
            </Frame>

            <Frame
                x:Name="FiltroEsteMes"
                Padding="14,8"
                CornerRadius="20"
                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackground}, Dark={StaticResource InputBackgroundDark}}"
                BorderColor="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}"
                HasShadow="False">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFiltroTapped" CommandParameter="ESTE MES" />
                </Frame.GestureRecognizers>
                <Label
                    Text="ESTE MES"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                    VerticalOptions="Center" />
            </Frame>
        </HorizontalStackLayout>

        <!-- Lista de gastos -->
        <CollectionView
            Grid.Row="2"
            x:Name="GastosCollectionView"
            ItemsSource="{Binding Gastos}"
            SelectionMode="None"
            ItemSizingStrategy="MeasureAllItems"
            Margin="16,0">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView Margin="0,0,0,12">
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem
                                    BackgroundColor="#4CAF50"
                                    Invoked="OnEditSwipeItemInvoked"
                                    Text="✏️ Editar" />
                                <SwipeItem
                                    BackgroundColor="#F44336"
                                    Invoked="OnDeleteSwipeItemInvoked"
                                    Text="🗑️ Eliminar" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <!-- Tarjeta estilo ventas -->
                        <Frame
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                            BorderColor="Transparent"
                            CornerRadius="16"
                            HasShadow="False">

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemTapped" />
                            </Frame.GestureRecognizers>

                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Fila 0: Descripción (campo principal) -->
                                <Label
                                    Grid.Row="0"
                                    Text="{Binding Descripcion}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    LineBreakMode="TailTruncation" />

                                <!-- Fila 1: Fecha -->
                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        Text="📅 FECHA DE GASTO"
                                        FontSize="10"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                        Margin="0,0,0,2" />
                                    <Label
                                        Grid.Row="1"
                                        Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                        FontSize="14"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </Grid>

                                <!-- Fila 2: Total + Desglose (igual que Ventas) -->
                                <Grid Grid.Row="2" ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Total a la izquierda -->
                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Text="TOTAL"
                                            FontSize="10"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                            Margin="0,0,0,2" />
                                        <Label
                                            Grid.Row="1"
                                            Text="{Binding TotalCalculadoFormateado, StringFormat='${0}'}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="#FF9800" />
                                    </Grid>

                                    <!-- Desglose a la derecha -->
                                    <Grid Grid.Column="1" HorizontalOptions="End">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Text="DESGLOSE"
                                            FontSize="10"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                            Margin="0,0,0,2" />

                                        <!-- Sin artículos: formato legacy -->
                                        <HorizontalStackLayout
                                            Grid.Row="1"
                                            Spacing="0"
                                            IsVisible="{Binding TieneArticulos, Converter={StaticResource InvertBool}}">
                                            <Label
                                                Text="{Binding Monto, StringFormat='${0:N2}'}"
                                                FontSize="14"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            <Label
                                                Text=" x "
                                                FontSize="14"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            <Label
                                                Text="{Binding Cantidad}"
                                                FontSize="14"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            <Label
                                                Text="{Binding UnidadTexto}"
                                                FontSize="14"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                        </HorizontalStackLayout>

                                        <!-- Con artículos: descripción + desglose por artículo -->
                                        <VerticalStackLayout
                                            Grid.Row="1"
                                            Spacing="2"
                                            IsVisible="{Binding TieneArticulos}"
                                            HorizontalOptions="End">
                                            <!-- Artículo 1 -->
                                            <Label
                                                Text="{Binding DesgloseDesc1}"
                                                FontSize="10"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                HorizontalTextAlignment="End"
                                                LineBreakMode="TailTruncation"
                                                IsVisible="{Binding TieneArticulos}" />
                                            <Label
                                                Text="{Binding DesgloseLinea1}"
                                                FontSize="13"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                HorizontalTextAlignment="End"
                                                IsVisible="{Binding TieneArticulos}" />
                                            <!-- Artículo 2 -->
                                            <Label
                                                Text="{Binding DesgloseDesc2}"
                                                FontSize="10"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                HorizontalTextAlignment="End"
                                                LineBreakMode="TailTruncation"
                                                IsVisible="{Binding DesgloseDesc2, Converter={StaticResource StringNotEmpty}}" />
                                            <Label
                                                Text="{Binding DesgloseLinea2}"
                                                FontSize="13"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                HorizontalTextAlignment="End"
                                                IsVisible="{Binding DesgloseLinea2, Converter={StaticResource StringNotEmpty}}" />
                                            <!-- Artículo 3 -->
                                            <Label
                                                Text="{Binding DesgloseDesc3}"
                                                FontSize="10"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                HorizontalTextAlignment="End"
                                                LineBreakMode="TailTruncation"
                                                IsVisible="{Binding DesgloseDesc3, Converter={StaticResource StringNotEmpty}}" />
                                            <Label
                                                Text="{Binding DesgloseLinea3}"
                                                FontSize="13"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                HorizontalTextAlignment="End"
                                                IsVisible="{Binding DesgloseLinea3, Converter={StaticResource StringNotEmpty}}" />
                                            <!-- Artículo 4 -->
                                            <Label
                                                Text="{Binding DesgloseDesc4}"
                                                FontSize="10"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                HorizontalTextAlignment="End"
                                                LineBreakMode="TailTruncation"
                                                IsVisible="{Binding DesgloseDesc4, Converter={StaticResource StringNotEmpty}}" />
                                            <Label
                                                Text="{Binding DesgloseLinea4}"
                                                FontSize="13"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                HorizontalTextAlignment="End"
                                                IsVisible="{Binding DesgloseLinea4, Converter={StaticResource StringNotEmpty}}" />
                                            <!-- Artículo 5 -->
                                            <Label
                                                Text="{Binding DesgloseDesc5}"
                                                FontSize="10"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                HorizontalTextAlignment="End"
                                                LineBreakMode="TailTruncation"
                                                IsVisible="{Binding DesgloseDesc5, Converter={StaticResource StringNotEmpty}}" />
                                            <Label
                                                Text="{Binding DesgloseLinea5}"
                                                FontSize="13"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                HorizontalTextAlignment="End"
                                                IsVisible="{Binding DesgloseLinea5, Converter={StaticResource StringNotEmpty}}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>

                                <!-- Fila 3: Acciones -->
                                <HorizontalStackLayout
                                    Grid.Row="3"
                                    HorizontalOptions="End"
                                    Spacing="16">
                                    <Label
                                        Text="✏️"
                                        FontSize="20"
                                        VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnEditarTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label
                                        Text="🗑️"
                                        FontSize="20"
                                        VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnEliminarTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </HorizontalStackLayout>
                            </Grid>
                        </Frame>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Mensaje cuando no hay gastos -->
            <CollectionView.EmptyView>
                <StackLayout
                    Padding="20"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="15">

                    <Label
                        FontSize="48"
                        Text="💸"
                        HorizontalTextAlignment="Center" />

                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="No hay gastos registrados"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        FontSize="14"
                        Text="Los gastos aparecerán aquí cuando se registren"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                        HorizontalTextAlignment="Center" />
                </StackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mercader.Gastos"
             Title="Gastos">

    <ScrollView>
        <StackLayout>
            <Label Text="Lista de Gastos" 
                   FontSize="Large" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Start" />

            <!-- Encabezados de las columnas -->
            <Grid Padding="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Text="Descripción" FontAttributes="Bold" Padding="2"/>
                <Label Grid.Column="1" Text="Monto" FontAttributes="Bold" />
                <Label Grid.Column="2" Text="Cantidad" FontAttributes="Bold" />
                <Label Grid.Column="3" Text="Fecha" FontAttributes="Bold" />
            </Grid>

            <CollectionView x:Name="GastosCollectionView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="{Binding Descripcion}" TextColor="Coral" Padding="3"/>
                            <Label Grid.Column="1" Text="{Binding Monto}" TextColor="Coral"/>
                            <Label Grid.Column="2" Text="{Binding Cantidad}" TextColor="Coral"/>
                            <Label Grid.Column="3" Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" TextColor="Coral"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
    </ScrollView>
</ContentPage>
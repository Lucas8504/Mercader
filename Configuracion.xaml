<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.Configuracion"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="⚙️ Configuración"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Sección: General -->
            <Label
                Text="General"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <Frame Padding="15" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                <VerticalStackLayout Spacing="10">
                    <!-- Moneda -->
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Moneda" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Text="Símbolo de moneda para los precios" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>
                        <Picker
                            x:Name="MonedaPicker"
                            Grid.Column="1"
                            WidthRequest="100"
                            SelectedIndex="0"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>$</x:String>
                                    <x:String>USD</x:String>
                                    <x:String>€</x:String>
                                    <x:String>R$</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Grid>

                    <BoxView HeightRequest="0.5" Color="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}" Margin="0,4" />

                    <!-- Tema -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Tema" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Text="Elegí cómo se ve la app" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                        <Grid ColumnDefinitions="*,6,*,6,*" x:Name="TemaSelector" Margin="0,4,0,0">
                            <!-- Sistema -->
                            <Frame x:Name="TemaSistemaFrame" Grid.Column="0" Padding="6,8" CornerRadius="10" HasShadow="False"
                                   BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                                   BorderColor="Transparent">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTemaSistemaTapped" />
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="📱" FontSize="16" HorizontalOptions="Center" />
                                    <Label Text="Sistema" FontSize="11" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </VerticalStackLayout>
                            </Frame>

                            <!-- Claro -->
                            <Frame x:Name="TemaClaroFrame" Grid.Column="2" Padding="6,8" CornerRadius="10" HasShadow="False"
                                   BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                                   BorderColor="Transparent">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTemaClaroTapped" />
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="☀️" FontSize="16" HorizontalOptions="Center" />
                                    <Label Text="Claro" FontSize="11" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </VerticalStackLayout>
                            </Frame>

                            <!-- Oscuro -->
                            <Frame x:Name="TemaOscuroFrame" Grid.Column="4" Padding="6,8" CornerRadius="10" HasShadow="False"
                                   BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                                   BorderColor="Transparent">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTemaOscuroTapped" />
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="🌙" FontSize="16" HorizontalOptions="Center" />
                                    <Label Text="Oscuro" FontSize="11" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Sección: Notificaciones -->
            <Label
                Text="Notificaciones"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <Frame Padding="15" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                <VerticalStackLayout Spacing="10">
                    <!-- Recordatorio de entregas -->
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Recordatorio de entregas" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Text="Notificar encargos pendientes" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>
                        <Switch x:Name="NotificacionEntregasSwitch" Grid.Column="1" Toggled="OnNotificacionEntregasToggled" />
                    </Grid>

                    <!-- Tiempo de recordatorio -->
                    <Grid ColumnDefinitions="*, Auto" x:Name="TiempoRecordatorioGrid" IsVisible="False">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Recordar antes" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>
                        <Picker
                            x:Name="TiempoRecordatorioPicker"
                            Grid.Column="1"
                            WidthRequest="140"
                            SelectedIndex="1"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                            SelectedIndexChanged="OnTiempoRecordatorioChanged">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>El día de entrega</x:String>
                                    <x:String>1 hora antes</x:String>
                                    <x:String>2 horas antes</x:String>
                                    <x:String>1 día antes</x:String>
                                    <x:String>2 días antes</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Grid>

                    <BoxView HeightRequest="0.5" Color="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Sección: Datos -->
            <Label
                Text="Datos"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <Frame Padding="15" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                <VerticalStackLayout Spacing="10">
                    <!-- Exportar datos -->
                    <Button
                        Text="📤 Exportar Datos"
                        BackgroundColor="#0A84FF"
                        TextColor="White"
                        Clicked="OnExportarClicked" />

                    <Button
                        Text="📄 Exportar Balance en PDF"
                        BackgroundColor="#0A84FF"
                        TextColor="White"
                        Clicked="OnExportarPdfClicked" />

                    <BoxView HeightRequest="0.5" Color="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}" />

                    <!-- Importar datos -->
                    <Button
                        Text="📥 Importar Datos"
                        BackgroundColor="#5E5CE6"
                        TextColor="White"
                        Clicked="OnImportarClicked" />

                    <BoxView HeightRequest="0.5" Color="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}" />

                    <!-- Limpiar datos -->
                    <Button
                        Text="🗑️ Limpiar Todos los Datos"
                        BackgroundColor="#FF453A"
                        TextColor="White"
                        Clicked="OnLimpiarDatosClicked" />
                </VerticalStackLayout>
            </Frame>

            <!-- Sección: Acerca de -->
            <Label
                Text="Acerca de"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <Frame Padding="15" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Mercader" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="Versión 1.0.0" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Text="Gestión de ventas, gastos y encargos" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.EditarVentaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Editar Venta"
    BackgroundColor="#1e1e1e">

    <ScrollView>
        <VerticalStackLayout
            Margin="20"
            Padding="20"
            Spacing="20">

            <!-- Título principal -->
            <Label
                FontAttributes="Bold"
                FontSize="24"
                HorizontalTextAlignment="Center"
                Text="Editar Venta"
                TextColor="#ffffff" />

            <!-- Card principal con el formulario -->
            <Frame
                Padding="20"
                BackgroundColor="#2a2a2a"
                CornerRadius="12"
                HasShadow="True">
                <VerticalStackLayout Spacing="20">

                    <!-- Campo Descripción -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Descripción del Producto:"
                            TextColor="#4CAF50" />
                        <Frame
                            Padding="0"
                            BackgroundColor="#3a3a3a"
                            CornerRadius="8"
                            HasShadow="False">
                            <Entry
                                x:Name="DescripcionEntry"
                                BackgroundColor="Transparent"
                                FontSize="16"
                                Placeholder="Describe el producto o servicio"
                                PlaceholderColor="#888888"
                                TextColor="#ffffff" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Grid para Precio y Cantidad -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Campo Precio -->
                        <VerticalStackLayout Grid.Column="0" Spacing="8">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Precio:"
                                TextColor="#4CAF50" />
                            <Frame
                                Padding="0"
                                BackgroundColor="#3a3a3a"
                                CornerRadius="8"
                                HasShadow="False">
                                <Entry
                                    x:Name="PrecioEntry"
                                    BackgroundColor="Transparent"
                                    FontSize="16"
                                    Keyboard="Numeric"
                                    Placeholder="0.00"
                                    PlaceholderColor="#888888"
                                    TextColor="#FFC107" />
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Campo Cantidad -->
                        <VerticalStackLayout Grid.Column="2" Spacing="8">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Cantidad:"
                                TextColor="#4CAF50" />
                            <Frame
                                Padding="0"
                                BackgroundColor="#3a3a3a"
                                CornerRadius="8"
                                HasShadow="False">
                                <Entry
                                    x:Name="CantidadEntry"
                                    BackgroundColor="Transparent"
                                    FontSize="16"
                                    Keyboard="Numeric"
                                    Placeholder="1"
                                    PlaceholderColor="#888888"
                                    TextColor="#ffffff" />
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Información del total calculado -->
                    <Frame
                        Padding="15"
                        BackgroundColor="#1e1e1e"
                        CornerRadius="8"
                        HasShadow="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Total Estimado:"
                                TextColor="#4CAF50"
                                VerticalOptions="Center" />
                            <Label
                                x:Name="LabelTotalCalculado"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="$0.00"
                                TextColor="#FFC107"
                                VerticalOptions="Center" />
                        </Grid>
                    </Frame>

                </VerticalStackLayout>
            </Frame>

            <!-- Botones de acción -->
            <VerticalStackLayout Spacing="15">

                <!-- Botón Guardar -->
                <Button
                    x:Name="BtnGuardar"
                    BackgroundColor="#4CAF50"
                    Clicked="OnGuardarClicked"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="50"
                    Text="💾 Guardar Cambios"
                    TextColor="White" />

                <!-- Botón Cancelar -->
                <Button
                    x:Name="BtnCancelar"
                    BackgroundColor="#666666"
                    Clicked="OnCancelarClicked"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="50"
                    Text="❌ Cancelar"
                    TextColor="White" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
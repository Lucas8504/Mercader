<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.EditarVentaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <StackLayout Padding="10">
        <Label FontSize="Large" Text="Editar Venta" />
        <Entry x:Name="DescripcionEntry" Placeholder="Descripción" />
        <Entry
            x:Name="PrecioEntry"
            Keyboard="Numeric"
            Placeholder="Precio" />
        <Entry
            x:Name="CantidadEntry"
            Keyboard="Numeric"
            Placeholder="Cantidad" />

        <Button Clicked="OnGuardarClicked" Text="Guardar" />
    </StackLayout>
</ContentPage>
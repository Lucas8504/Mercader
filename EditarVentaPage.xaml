<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.EditarVentaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:domain="clr-namespace:Mercader.Domain.Entities;assembly=Mercader.Core"
    Title="Editar Venta"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout
            Margin="20"
            Padding="20"
            Spacing="20">

            <!-- Título principal -->
            <Label
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Center"
                Text="Editar Venta"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <!-- Campo Descripción -->
            <Frame
                Padding="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Entry
                    x:Name="DescripcionEntry"
                    BackgroundColor="Transparent"
                    Placeholder="Descripción de la venta"
                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    Visual="Material" />
            </Frame>

            <!-- ===== MULTI-ARTÍCULO ===== -->
            <Label
                FontAttributes="Bold"
                FontSize="16"
                Text="Artículos"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <VerticalStackLayout
                x:Name="ArticulosStack"
                Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="domain:ArticuloVenta">
                        <Frame
                            Padding="12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                            CornerRadius="8"
                            HasShadow="False">
                            <VerticalStackLayout Spacing="8">
                                <!-- Descripción -->
                                <VerticalStackLayout Spacing="4">
                                    <Label
                                        FontSize="11"
                                        Text="Descripción"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Entry
                                        BackgroundColor="Transparent"
                                        Placeholder="Nombre del artículo"
                                        PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                        Text="{Binding Descripcion, Mode=TwoWay}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                        Visual="Material" />
                                </VerticalStackLayout>

                                <!-- Precio y Cantidad en fila -->
                                <Grid ColumnDefinitions="*,8,*" ColumnSpacing="0">
                                    <!-- Precio Unitario -->
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label
                                            FontSize="11"
                                            Text="Precio Unitario"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                        <Entry
                                            BackgroundColor="Transparent"
                                            Keyboard="Numeric"
                                            Placeholder="0"
                                            PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                            Text="{Binding PrecioUnitario, Mode=TwoWay, Converter={StaticResource DecimalToEmpty}}"
                                            TextChanged="OnArticuloFieldChanged"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            Visual="Material" />
                                    </VerticalStackLayout>

                                    <!-- Cantidad -->
                                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                                        <Label
                                            FontSize="11"
                                            Text="Cantidad"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                        <Entry
                                            BackgroundColor="Transparent"
                                            Keyboard="Numeric"
                                            Placeholder="1"
                                            PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                            Text="{Binding Cantidad, Mode=TwoWay, Converter={StaticResource DecimalToEmpty}}"
                                            TextChanged="OnArticuloFieldChanged"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            Visual="Material" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Botones de acción -->
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                    <Button
                                        Grid.Column="1"
                                        BackgroundColor="Transparent"
                                        Clicked="OnSubirArticulo"
                                        FontSize="14"
                                        Padding="4"
                                        Text="⬆" />
                                    <Button
                                        Grid.Column="2"
                                        BackgroundColor="Transparent"
                                        Clicked="OnBajarArticulo"
                                        FontSize="14"
                                        Padding="4"
                                        Text="⬇" />
                                    <Button
                                        Grid.Column="3"
                                        BackgroundColor="#FF5252"
                                        Clicked="OnEliminarArticulo"
                                        FontSize="14"
                                        Padding="4"
                                        Text="✕"
                                        TextColor="White" />
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Botón Agregar Artículo -->
            <Button
                Padding="10"
                BackgroundColor="{AppThemeBinding Light=#2196F3, Dark=#90CAF9}"
                Clicked="OnAgregarArticuloClicked"
                CornerRadius="8"
                FontSize="14"
                Text="+ Agregar artículo"
                TextColor="White" />

            <!-- Total calculado -->
            <Frame
                Padding="12"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Total:"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        VerticalOptions="Center" />
                    <Label
                        x:Name="TotalLabel"
                        Grid.Column="2"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="$0"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- Botones de acción -->
            <VerticalStackLayout Spacing="15">
                <Button
                    x:Name="BtnGuardar"
                    Padding="15"
                    BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#A5D6A7}"
                    Clicked="OnGuardarClicked"
                    CornerRadius="8"
                    FontSize="16"
                    Text="💾 Guardar Cambios"
                    TextColor="White" />

                <Button
                    x:Name="BtnCancelar"
                    Padding="15"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ButtonSecondaryLight}, Dark={StaticResource ButtonSecondaryDark}}"
                    Clicked="OnCancelarClicked"
                    CornerRadius="8"
                    FontSize="16"
                    Text="❌ Cancelar"
                    TextColor="White" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

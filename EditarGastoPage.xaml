<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.EditarGastoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:domain="clr-namespace:Mercader.Domain.Entities;assembly=Mercader.Core"
    Title="Editar Gasto"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout
            Margin="20"
            Padding="20"
            Spacing="20">

            <!-- Título principal -->
            <Label
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Center"
                Text="Editar Gasto"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <!-- Campo Descripción -->
            <Frame
                Padding="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Entry
                    x:Name="DescripcionEntry"
                    BackgroundColor="Transparent"
                    Placeholder="Descripción del gasto"
                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                    Text="{Binding Descripcion, Mode=TwoWay}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    Visual="Material" />
            </Frame>

            <!-- ===== MULTI-ARTÍCULO ===== -->
            <Label
                FontAttributes="Bold"
                FontSize="16"
                Text="Artículos"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <VerticalStackLayout
                x:Name="ArticulosStack"
                Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="domain:ArticuloGasto">
                        <Frame
                            Padding="12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                            CornerRadius="8"
                            HasShadow="False">
                            <VerticalStackLayout Spacing="8">
                                <!-- Descripción -->
                                <VerticalStackLayout Spacing="4">
                                    <Label
                                        FontSize="11"
                                        Text="Descripción"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Entry
                                        BackgroundColor="Transparent"
                                        Placeholder="Nombre del artículo"
                                        PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                        Text="{Binding Descripcion, Mode=TwoWay}"
                                        TextChanged="OnArticuloFieldChanged"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                        Visual="Material" />
                                </VerticalStackLayout>

                                <!-- Image picker - 4 slot grid -->
                                <Grid ColumnDefinitions="65,65,65,65" ColumnSpacing="8" Margin="0,5,0,0">
                                    <!-- Slot 0 -->
                                    <Frame Grid.Column="0" WidthRequest="60" HeightRequest="60" Padding="0" IsClippedToBounds="True" CornerRadius="8">
                                        <Grid>
                                            <Image Source="{Binding ImagenPath1}" Aspect="AspectFill" IsVisible="{Binding HasImage}" />
                                            <Frame x:Name="EmptySlot0" BackgroundColor="#F0F0F0" IsVisible="{Binding ImagenPath1, Converter={StaticResource InvertBool}}" Padding="0" StyleId="0">
                                                <Label Text="📷" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnEmptySlotTapped" />
                                                </Frame.GestureRecognizers>
                                            </Frame>
                                        </Grid>
                                    </Frame>
                                    <Button Grid.Column="0" Text="✕" Clicked="OnClearSlotClicked" StyleId="0"
                                            BackgroundColor="Transparent" TextColor="Red" FontSize="12"
                                            HorizontalOptions="End" VerticalOptions="Start" Padding="0" IsVisible="{Binding ImagenPath1, Converter={StaticResource StringNotEmpty}}"/>
                                    
                                    <!-- Slot 1 -->
                                    <Frame Grid.Column="1" WidthRequest="60" HeightRequest="60" Padding="0" IsClippedToBounds="True" CornerRadius="8">
                                        <Grid>
                                            <Image Source="{Binding ImagenPath2}" Aspect="AspectFill" IsVisible="{Binding HasImage}" />
                                            <Frame x:Name="EmptySlot1" BackgroundColor="#F0F0F0" IsVisible="{Binding ImagenPath2, Converter={StaticResource InvertBool}}" Padding="0" StyleId="1">
                                                <Label Text="📷" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnEmptySlotTapped" />
                                                </Frame.GestureRecognizers>
                                            </Frame>
                                        </Grid>
                                    </Frame>
                                    <Button Grid.Column="1" Text="✕" Clicked="OnClearSlotClicked" StyleId="1"
                                            BackgroundColor="Transparent" TextColor="Red" FontSize="12"
                                            HorizontalOptions="End" VerticalOptions="Start" Padding="0" IsVisible="{Binding ImagenPath2, Converter={StaticResource StringNotEmpty}}"/>
                                    
                                    <!-- Slot 2 -->
                                    <Frame Grid.Column="2" WidthRequest="60" HeightRequest="60" Padding="0" IsClippedToBounds="True" CornerRadius="8">
                                        <Grid>
                                            <Image Source="{Binding ImagenPath3}" Aspect="AspectFill" IsVisible="{Binding HasImage}" />
                                            <Frame x:Name="EmptySlot2" BackgroundColor="#F0F0F0" IsVisible="{Binding ImagenPath3, Converter={StaticResource InvertBool}}" Padding="0" StyleId="2">
                                                <Label Text="📷" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnEmptySlotTapped" />
                                                </Frame.GestureRecognizers>
                                            </Frame>
                                        </Grid>
                                    </Frame>
                                    <Button Grid.Column="2" Text="✕" Clicked="OnClearSlotClicked" StyleId="2"
                                            BackgroundColor="Transparent" TextColor="Red" FontSize="12"
                                            HorizontalOptions="End" VerticalOptions="Start" Padding="0" IsVisible="{Binding ImagenPath3, Converter={StaticResource StringNotEmpty}}"/>
                                    
                                    <!-- Slot 3 -->
                                    <Frame Grid.Column="3" WidthRequest="60" HeightRequest="60" Padding="0" IsClippedToBounds="True" CornerRadius="8">
                                        <Grid>
                                            <Image Source="{Binding ImagenPath4}" Aspect="AspectFill" IsVisible="{Binding HasImage}" />
                                            <Frame x:Name="EmptySlot3" BackgroundColor="#F0F0F0" IsVisible="{Binding ImagenPath4, Converter={StaticResource InvertBool}}" Padding="0" StyleId="3">
                                                <Label Text="📷" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnEmptySlotTapped" />
                                                </Frame.GestureRecognizers>
                                            </Frame>
                                        </Grid>
                                    </Frame>
                                    <Button Grid.Column="3" Text="✕" Clicked="OnClearSlotClicked" StyleId="3"
                                            BackgroundColor="Transparent" TextColor="Red" FontSize="12"
                                            HorizontalOptions="End" VerticalOptions="Start" Padding="0" IsVisible="{Binding ImagenPath4, Converter={StaticResource StringNotEmpty}}"/>
                                </Grid>

                                <!-- Precio y Cantidad en fila -->
                                <Grid ColumnDefinitions="*,8,*" ColumnSpacing="0">
                                    <!-- Precio Unitario -->
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label
                                            FontSize="11"
                                            Text="Precio Unitario"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                        <Entry
                                            BackgroundColor="Transparent"
                                            Keyboard="Numeric"
                                            Placeholder="0"
                                            PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                            Text="{Binding PrecioUnitario, Mode=TwoWay, Converter={StaticResource DecimalToEmpty}}"
                                            TextChanged="OnArticuloFieldChanged"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            Visual="Material" />
                                    </VerticalStackLayout>

                                    <!-- Cantidad -->
                                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                                        <Label
                                            FontSize="11"
                                            Text="Cantidad"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                        <Entry
                                            BackgroundColor="Transparent"
                                            Keyboard="Numeric"
                                            Placeholder="1"
                                            PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                            Text="{Binding Cantidad, Mode=TwoWay, Converter={StaticResource DecimalToEmpty}}"
                                            TextChanged="OnArticuloFieldChanged"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            Visual="Material" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Botones de acción -->
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                    <Button
                                        Grid.Column="1"
                                        BackgroundColor="Transparent"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type Page}}, Path=BindingContext.SubirArticuloCommand}"
                                        CommandParameter="{Binding .}"
                                        FontSize="14"
                                        Padding="4"
                                        Text="⬆" />
                                    <Button
                                        Grid.Column="2"
                                        BackgroundColor="Transparent"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type Page}}, Path=BindingContext.BajarArticuloCommand}"
                                        CommandParameter="{Binding .}"
                                        FontSize="14"
                                        Padding="4"
                                        Text="⬇" />
                                    <Button
                                        Grid.Column="3"
                                        BackgroundColor="#FF5252"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type Page}}, Path=BindingContext.EliminarArticuloCommand}"
                                        CommandParameter="{Binding .}"
                                        FontSize="14"
                                        Padding="4"
                                        Text="✕"
                                        TextColor="White" />
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Botón Agregar Artículo -->
            <Button
                Padding="10"
                BackgroundColor="{AppThemeBinding Light=#2196F3, Dark=#90CAF9}"
                Command="{Binding AgregarArticuloCommand}"
                CornerRadius="8"
                FontSize="14"
                Text="+ Agregar artículo"
                TextColor="White" />

            <!--  Lista de sugerencias para autocompletado de artículos  -->
            <Frame
                x:Name="ArticuloSuggestionsFrame"
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False"
                IsVisible="False"
                MaximumHeightRequest="200">
                <CollectionView
                    x:Name="ArticuloSuggestionsView"
                    SelectionMode="Single"
                    SelectionChanged="OnArticuloSuggestionSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid
                                Padding="12,10"
                                ColumnSpacing="0"
                                BackgroundColor="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnArticuloSuggestionTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Grid.Column="0"
                                    Text="{Binding .}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    FontSize="15"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="✕"
                                    TextColor="#FF5252"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    Padding="8,4">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnArticuloDismissSuggestionTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>

            <!-- Total calculado -->
            <Frame
                Padding="12"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Total:"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        VerticalOptions="Center" />
                    <Label
                        x:Name="TotalLabel"
                        Grid.Column="2"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="$0"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- Botones de acción -->
            <VerticalStackLayout Spacing="15">
                <Button
                    x:Name="BtnGuardar"
                    Padding="15"
                    BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#A5D6A7}"
                    Clicked="OnGuardarClicked"
                    CornerRadius="8"
                    FontSize="16"
                    Text="💾 Guardar Cambios"
                    TextColor="White" />

                <Button
                    x:Name="BtnCancelar"
                    Padding="15"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ButtonSecondaryLight}, Dark={StaticResource ButtonSecondaryDark}}"
                    Clicked="OnCancelarClicked"
                    CornerRadius="8"
                    FontSize="16"
                    Text="❌ Cancelar"
                    TextColor="White" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
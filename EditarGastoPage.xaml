<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.EditarGastoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Editar Gasto"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout
            Margin="20"
            Padding="20"
            Spacing="20">

            <!-- Título principal -->
            <Label
                FontAttributes="Bold"
                FontSize="24"
                HorizontalTextAlignment="Center"
                Text="Editar Gasto"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <!-- Card principal con el formulario -->
            <Frame
                Padding="20"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="12"
                HasShadow="True">
                <VerticalStackLayout Spacing="20">

                    <!-- Campo Descripción -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Descripción del Gasto:"
                            TextColor="#4CAF50" />
                        <Frame
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBackground}, Dark={StaticResource InputBackgroundDark}}"
                            CornerRadius="8"
                            HasShadow="False">
                            <Entry
                                x:Name="DescripcionEntry"
                                BackgroundColor="Transparent"
                                FontSize="16"
                                Placeholder="Describe el gasto realizado"
                                PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Grid para Precio y Cantidad -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Campo Precio -->
                        <VerticalStackLayout Grid.Column="0" Spacing="8">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Precio:"
                                TextColor="#4CAF50" />
                            <Frame
                                Padding="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackground}, Dark={StaticResource InputBackgroundDark}}"
                                CornerRadius="8"
                                HasShadow="False">
                                <Entry
                                    x:Name="PrecioEntry"
                                    BackgroundColor="Transparent"
                                    FontSize="16"
                                    Keyboard="Numeric"
                                    Placeholder="0.00"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                    TextColor="#FF5722" />
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Campo Cantidad -->
                        <VerticalStackLayout Grid.Column="2" Spacing="8">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Cantidad:"
                                TextColor="#4CAF50" />
                            <Frame
                                Padding="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackground}, Dark={StaticResource InputBackgroundDark}}"
                                CornerRadius="8"
                                HasShadow="False">
                                <Entry
                                    x:Name="CantidadEntry"
                                    BackgroundColor="Transparent"
                                    FontSize="16"
                                    Keyboard="Numeric"
                                    Placeholder="1"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Información del total calculado -->
                    <Frame
                        Padding="15"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                        CornerRadius="8"
                        HasShadow="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Total del Gasto:"
                                TextColor="#4CAF50"
                                VerticalOptions="Center" />
                            <Label
                                x:Name="LabelTotalCalculado"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="$0.00"
                                TextColor="#FF5722"
                                VerticalOptions="Center" />
                        </Grid>
                    </Frame>

                </VerticalStackLayout>
            </Frame>

            <!-- Botones de acción -->
            <VerticalStackLayout Spacing="15">

                <!-- Botón Guardar -->
                <Button
                    x:Name="BtnGuardar"
                    BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#A5D6A7}"
                    Clicked="OnGuardarClicked"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="50"
                    Text="💾 Guardar Cambios"
                    TextColor="White" />

                <!-- Botón Cancelar -->
                <Button
                    x:Name="BtnCancelar"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ButtonSecondaryLight}, Dark={StaticResource ButtonSecondaryDark}}"
                    Clicked="OnCancelarClicked"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="50"
                    Text="❌ Cancelar"
                    TextColor="White" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
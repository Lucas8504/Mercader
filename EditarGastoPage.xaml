<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.EditarGastoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:domain="clr-namespace:Mercader.Domain.Entities;assembly=Mercader.Core"
    Title="Editar Gasto"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout
            Margin="20"
            Padding="20"
            Spacing="20">

            <!-- Título principal -->
            <Label
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Center"
                Text="Editar Gasto"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <!-- Campo Descripción -->
            <Frame
                Padding="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Entry
                    x:Name="DescripcionEntry"
                    BackgroundColor="Transparent"
                    Placeholder="Descripción del gasto"
                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    Visual="Material" />
            </Frame>

            <!-- ===== MULTI-ARTÍCULO ===== -->
            <Label
                FontAttributes="Bold"
                FontSize="16"
                Text="Artículos"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <VerticalStackLayout
                x:Name="ArticulosStack"
                Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="domain:ArticuloGasto">
                        <Frame
                            Padding="8"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                            CornerRadius="8"
                            HasShadow="False">
                            <Grid
                                ColumnDefinitions="*,32,32,32,40"
                                RowDefinitions="Auto,Auto"
                                ColumnSpacing="4"
                                RowSpacing="6">
                                <!-- Descripción -->
                                <Entry
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="5"
                                    BackgroundColor="Transparent"
                                    Placeholder="Descripción"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                    Text="{Binding Descripcion, Mode=TwoWay}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    Visual="Material" />
                                <!-- Precio Unitario -->
                                <Entry
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    BackgroundColor="Transparent"
                                    Keyboard="Numeric"
                                    Placeholder="P/U"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                    Text="{Binding PrecioUnitario, Mode=TwoWay}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    Visual="Material" />
                                <!-- Cantidad -->
                                <Entry
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    Keyboard="Numeric"
                                    Placeholder="Cant."
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                    Text="{Binding Cantidad, Mode=TwoWay}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    Visual="Material" />
                                <!-- Subir -->
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    BackgroundColor="Transparent"
                                    Clicked="OnSubirArticulo"
                                    FontSize="12"
                                    Padding="0"
                                    Text="⬆" />
                                <!-- Bajar -->
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    BackgroundColor="Transparent"
                                    Clicked="OnBajarArticulo"
                                    FontSize="12"
                                    Padding="0"
                                    Text="⬇" />
                                <!-- Eliminar -->
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="4"
                                    BackgroundColor="#FF5252"
                                    Clicked="OnEliminarArticulo"
                                    FontSize="12"
                                    Padding="0"
                                    Text="✕"
                                    TextColor="White" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Botón Agregar Artículo -->
            <Button
                Padding="10"
                BackgroundColor="{AppThemeBinding Light=#2196F3, Dark=#90CAF9}"
                Clicked="OnAgregarArticuloClicked"
                CornerRadius="8"
                FontSize="14"
                Text="+ Agregar artículo"
                TextColor="White" />

            <!-- Total calculado -->
            <Frame
                Padding="12"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Total:"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        VerticalOptions="Center" />
                    <Label
                        x:Name="TotalLabel"
                        Grid.Column="2"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="$0"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- Botones de acción -->
            <VerticalStackLayout Spacing="15">
                <Button
                    x:Name="BtnGuardar"
                    Padding="15"
                    BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#A5D6A7}"
                    Clicked="OnGuardarClicked"
                    CornerRadius="8"
                    FontSize="16"
                    Text="💾 Guardar Cambios"
                    TextColor="White" />

                <Button
                    x:Name="BtnCancelar"
                    Padding="15"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ButtonSecondaryLight}, Dark={StaticResource ButtonSecondaryDark}}"
                    Clicked="OnCancelarClicked"
                    CornerRadius="8"
                    FontSize="16"
                    Text="❌ Cancelar"
                    TextColor="White" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

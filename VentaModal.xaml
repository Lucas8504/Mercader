<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.VentaModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Agregar Venta"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <!--  Fondo oscuro para combinar con MainPage  -->

    <ScrollView>
        <VerticalStackLayout
            Margin="20"
            Padding="20"
            Spacing="20">

            <!--  Título de la página  -->
            <Label
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Center"
                Text="Agregar Venta"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <!--  Campo de Descripción con autocompletado  -->
            <Frame
                Padding="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Entry
                    x:Name="DescripcionV_Entry"
                    BackgroundColor="Transparent"
                    Keyboard="Default"
                    Placeholder="Descripción"
                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    Visual="Material"
                    TextChanged="OnDescripcionTextChanged" />
            </Frame>

            <!--  Lista de sugerencias para autocompletado  -->
            <Frame
                x:Name="SuggestionsFrame"
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False"
                IsVisible="False"
                MaximumHeightRequest="200">
                <CollectionView
                    x:Name="SuggestionsView"
                    SelectionMode="Single"
                    SelectionChanged="OnSuggestionSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid
                                Padding="12,10"
                                ColumnSpacing="0"
                                BackgroundColor="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSuggestionTapped" />
                                </Grid.GestureRecognizers>

                                <!-- Texto de la sugerencia -->
                                <Label
                                    Grid.Column="0"
                                    Text="{Binding .}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    FontSize="15"
                                    VerticalOptions="Center" />

                                <!-- Botón para eliminar la sugerencia -->
                                <Label
                                    Grid.Column="1"
                                    Text="✕"
                                    TextColor="#FF5252"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    Padding="8,4">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDismissSuggestionTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>

            <!--  Campo de Precio  -->
            <Frame
                Padding="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Entry
                    x:Name="PrecioEntry"
                    BackgroundColor="Transparent"
                    Keyboard="Numeric"
                    Placeholder="Precio"
                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    Visual="Material" />
            </Frame>

            <!--  Campo de Cantidad  -->
            <Frame
                Padding="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Entry
                    x:Name="CantidadEntry"
                    BackgroundColor="Transparent"
                    Keyboard="Numeric"
                    Placeholder="Cantidad"
                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    Visual="Material" />
            </Frame>

            <!--  Botón Agregar  -->
            <Button
                Padding="15"
                BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#A5D6A7}"
                Clicked="OnAgregarVentaClicked"
                CornerRadius="8"
                FontSize="16"
                Text="Agregar"
                TextColor="White" />

            <!--  Botón Cancelar  -->
            <Button
                Padding="15"
                BackgroundColor="{AppThemeBinding Light=#FF5722, Dark=#FFAB91}"
                Clicked="Cancelar"
                CornerRadius="8"
                FontSize="16"
                Text="Cancelar"
                TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
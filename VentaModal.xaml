<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.VentaModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:domain="clr-namespace:Mercader.Domain.Entities;assembly=Mercader.Core"
    Title="Agregar Venta"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <!--  Fondo oscuro para combinar con MainPage  -->

    <ScrollView>
        <VerticalStackLayout
            Margin="20"
            Padding="20"
            Spacing="20">

            <!--  Título de la página  -->
            <Label
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Center"
                Text="Agregar Venta"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <!--  Campo de Descripción con autocompletado  -->
            <Frame
                Padding="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Entry
                    x:Name="DescripcionV_Entry"
                    BackgroundColor="Transparent"
                    Keyboard="Default"
                    Placeholder="Descripción"
                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    Visual="Material"
                    TextChanged="OnDescripcionTextChanged" />
            </Frame>

            <!--  Lista de sugerencias para autocompletado  -->
            <Frame
                x:Name="SuggestionsFrame"
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False"
                IsVisible="False"
                MaximumHeightRequest="200">
                <CollectionView
                    x:Name="SuggestionsView"
                    SelectionMode="Single"
                    SelectionChanged="OnSuggestionSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid
                                Padding="12,10"
                                ColumnSpacing="0"
                                BackgroundColor="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSuggestionTapped" />
                                </Grid.GestureRecognizers>

                                <!-- Texto de la sugerencia -->
                                <Label
                                    Grid.Column="0"
                                    Text="{Binding .}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    FontSize="15"
                                    VerticalOptions="Center" />

                                <!-- Botón para eliminar la sugerencia -->
                                <Label
                                    Grid.Column="1"
                                    Text="✕"
                                    TextColor="#FF5252"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    Padding="8,4">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDismissSuggestionTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>

            <!--  Campo de Precio  -->
            <Frame
                Padding="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Entry
                    x:Name="PrecioEntry"
                    BackgroundColor="Transparent"
                    Keyboard="Numeric"
                    Placeholder="Precio"
                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    Visual="Material" />
            </Frame>

            <!--  Campo de Cantidad  -->
            <Frame
                Padding="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Entry
                    x:Name="CantidadEntry"
                    BackgroundColor="Transparent"
                    Keyboard="Numeric"
                    Placeholder="Cantidad"
                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    Visual="Material" />
            </Frame>

            <!--  ===== MULTI-ARTÍCULO =====  -->
            <Label
                FontAttributes="Bold"
                FontSize="16"
                Text="Artículos"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <VerticalStackLayout
                x:Name="ArticulosStack"
                Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="domain:ArticuloVenta">
                        <Frame
                            Padding="8"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                            CornerRadius="8"
                            HasShadow="False">
                            <Grid
                                ColumnDefinitions="*,32,32,32,40"
                                RowDefinitions="Auto,Auto"
                                ColumnSpacing="4"
                                RowSpacing="6">
                                <!-- Descripción -->
                                <Entry
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="5"
                                    BackgroundColor="Transparent"
                                    Placeholder="Descripción"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                    Text="{Binding Descripcion, Mode=TwoWay}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    Visual="Material" />
                                <!-- Precio Unitario -->
                                <Entry
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    BackgroundColor="Transparent"
                                    Keyboard="Numeric"
                                    Placeholder="P/U"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                    Text="{Binding PrecioUnitario, Mode=TwoWay}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    Visual="Material" />
                                <!-- Cantidad -->
                                <Entry
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    Keyboard="Numeric"
                                    Placeholder="Cant."
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                    Text="{Binding Cantidad, Mode=TwoWay}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    Visual="Material" />
                                <!-- Subir -->
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    BackgroundColor="Transparent"
                                    Clicked="OnSubirArticulo"
                                    FontSize="12"
                                    Padding="0"
                                    Text="⬆" />
                                <!-- Bajar -->
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    BackgroundColor="Transparent"
                                    Clicked="OnBajarArticulo"
                                    FontSize="12"
                                    Padding="0"
                                    Text="⬇" />
                                <!-- Eliminar -->
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="4"
                                    BackgroundColor="#FF5252"
                                    Clicked="OnEliminarArticulo"
                                    FontSize="12"
                                    Padding="0"
                                    Text="✕"
                                    TextColor="White" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!--  Botón Agregar Artículo  -->
            <Button
                Padding="10"
                BackgroundColor="{AppThemeBinding Light=#2196F3, Dark=#90CAF9}"
                Clicked="OnAgregarArticuloClicked"
                CornerRadius="8"
                FontSize="14"
                Text="+ Agregar artículo"
                TextColor="White" />

            <!--  Total calculado  -->
            <Frame
                Padding="12"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Total:"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        VerticalOptions="Center" />
                    <Label
                        x:Name="TotalLabel"
                        Grid.Column="2"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="$0"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!--  Botón Agregar  -->
            <Button
                Padding="15"
                BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#A5D6A7}"
                Clicked="OnAgregarVentaClicked"
                CornerRadius="8"
                FontSize="16"
                Text="Agregar"
                TextColor="White" />

            <!--  Botón Cancelar  -->
            <Button
                Padding="15"
                BackgroundColor="{AppThemeBinding Light=#FF5722, Dark=#FFAB91}"
                Clicked="Cancelar"
                CornerRadius="8"
                FontSize="16"
                Text="Cancelar"
                TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
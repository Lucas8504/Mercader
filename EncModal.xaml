<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.EncModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:domain="clr-namespace:Mercader.Domain.Entities;assembly=Mercader.Core"
    xmlns:picker="clr-namespace:Syncfusion.Maui.Toolkit.Picker;assembly=Syncfusion.Maui.Toolkit"
    Title="Agregar Encargo"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <!-- Fondo oscuro para combinar con MainPage -->

    <ScrollView>
        <VerticalStackLayout
            Margin="20"
            Padding="20"
            Spacing="20">

            <!-- Título de la página -->
            <Label
                Text="Agregar Encargo"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                HorizontalOptions="Center" />

            <!-- Campo de cliente con autocompletado y selector de contactos -->
            <Frame
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                Padding="10"
                HasShadow="False">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Entry
                        x:Name="EncargoEntry"
                        Placeholder="Nombre del cliente"
                        PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        BackgroundColor="Transparent"
                        Visual="Material"
                        TextChanged="OnNombreEncargoTextChanged"
                        Grid.Column="0" />
                    <Button
                        x:Name="ContactosButton"
                        Text="👤"
                        BackgroundColor="Transparent"
                        FontSize="18"
                        Padding="8,0"
                        Clicked="OnContactosButtonClicked"
                        Grid.Column="1"
                        VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- Lista de sugerencias para autocompletado de nombres -->
            <Frame
                x:Name="NombreSuggestionsFrame"
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False"
                IsVisible="False"
                MaximumHeightRequest="200">
                <CollectionView
                    x:Name="NombreSuggestionsView"
                    SelectionMode="Single"
                    SelectionChanged="OnNombreSuggestionSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid
                                Padding="12,10"
                                ColumnSpacing="0"
                                BackgroundColor="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnNombreSuggestionTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Grid.Column="0"
                                    Text="{Binding .}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    FontSize="15"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="✕"
                                    TextColor="#FF5252"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    Padding="8,4">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnNombreDismissSuggestionTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>

            <!-- Campo de Teléfono mejorado -->
            <Frame
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                Padding="10"
                HasShadow="False">
                <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
                    <Label
                        Text="📞"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                        FontSize="16"
                        VerticalOptions="Center"
                        Grid.Column="0"
                        Margin="0,0,10,0" />
                    <Entry
                        x:Name="ContactoEntry"
                        Keyboard="Telephone"
                        Placeholder="Teléfono (ej: 11 1234-5678)"
                        PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        BackgroundColor="Transparent"
                        Visual="Material"
                        MaxLength="20"
                        Grid.Column="1"
                        />
                </Grid>
            </Frame>

            <!-- Campo de Descripción con autocompletado -->
            <Frame
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                Padding="10"
                HasShadow="False">
                <Entry
                    x:Name="DescripcionEntry"
                    Placeholder="Descripción"
                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    BackgroundColor="Transparent"
                    Visual="Material"
                    TextChanged="OnDescripcionEncargoTextChanged" />
            </Frame>

            <!-- Lista de sugerencias para autocompletado -->
            <Frame
                x:Name="EncargoSuggestionsFrame"
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False"
                IsVisible="False"
                MaximumHeightRequest="200">
                <CollectionView
                    x:Name="EncargoSuggestionsView"
                    SelectionMode="Single"
                    SelectionChanged="OnEncargoSuggestionSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid
                                Padding="12,10"
                                ColumnSpacing="0"
                                BackgroundColor="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEncargoSuggestionTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Grid.Column="0"
                                    Text="{Binding .}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    FontSize="15"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="✕"
                                    TextColor="#FF5252"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    Padding="8,4">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnEncargoDismissSuggestionTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>

            <!--  ===== MULTI-ARTÍCULO =====  -->
            <Label
                FontAttributes="Bold"
                FontSize="16"
                Text="Artículos"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <VerticalStackLayout
                x:Name="ArticulosStack"
                Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="domain:ArticuloEncargo">
                        <Frame
                            Padding="8"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                            CornerRadius="8"
                            HasShadow="False">
                            <Grid
                                ColumnDefinitions="*,32,32,32,40"
                                RowDefinitions="Auto,Auto"
                                ColumnSpacing="4"
                                RowSpacing="6">
                                <!-- Descripción -->
                                <Entry
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="5"
                                    BackgroundColor="Transparent"
                                    Placeholder="Descripción"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                    Text="{Binding Descripcion, Mode=TwoWay}"
                                    TextChanged="OnArticuloFieldChanged"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    Visual="Material" />
                                <!-- Precio Unitario -->
                                <Entry
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    BackgroundColor="Transparent"
                                    Keyboard="Numeric"
                                    Placeholder="P/U"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                    Text="{Binding PrecioUnitario, Mode=TwoWay, Converter={StaticResource DecimalToEmpty}}"
                                    TextChanged="OnArticuloFieldChanged"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    Visual="Material" />
                                <!-- Cantidad -->
                                <Entry
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    Keyboard="Numeric"
                                    Placeholder="Cant."
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                    Text="{Binding Cantidad, Mode=TwoWay, Converter={StaticResource DecimalToEmpty}}"
                                    TextChanged="OnArticuloFieldChanged"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    Visual="Material" />
                                <!-- Subir -->
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    BackgroundColor="Transparent"
                                    Clicked="OnSubirArticulo"
                                    FontSize="12"
                                    Padding="0"
                                    Text="⬆" />
                                <!-- Bajar -->
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    BackgroundColor="Transparent"
                                    Clicked="OnBajarArticulo"
                                    FontSize="12"
                                    Padding="0"
                                    Text="⬇" />
                                <!-- Eliminar -->
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="4"
                                    BackgroundColor="#FF5252"
                                    Clicked="OnEliminarArticulo"
                                    FontSize="12"
                                    Padding="0"
                                    Text="✕"
                                    TextColor="White" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!--  Botón Agregar Artículo  -->
            <Button
                Padding="10"
                BackgroundColor="{AppThemeBinding Light=#2196F3, Dark=#90CAF9}"
                Clicked="OnAgregarArticuloClicked"
                CornerRadius="8"
                FontSize="14"
                Text="+ Agregar artículo"
                TextColor="White" />

            <!--  Lista de sugerencias para autocompletado de artículos  -->
            <Frame
                x:Name="ArticuloSuggestionsFrame"
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False"
                IsVisible="False"
                MaximumHeightRequest="200">
                <CollectionView
                    x:Name="ArticuloSuggestionsView"
                    SelectionMode="Single"
                    SelectionChanged="OnArticuloSuggestionSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid
                                Padding="12,10"
                                ColumnSpacing="0"
                                BackgroundColor="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnArticuloSuggestionTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Grid.Column="0"
                                    Text="{Binding .}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    FontSize="15"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="✕"
                                    TextColor="#FF5252"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    Padding="8,4">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnArticuloDismissSuggestionTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>

            <!--  Total calculado  -->
            <Frame
                Padding="12"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Total:"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        VerticalOptions="Center" />
                    <Label
                        x:Name="TotalLabel"
                        Grid.Column="2"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="$0"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- Campo de Fecha de Entrega -->
            <Frame
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                Padding="10"
                HasShadow="False">
                <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
                    <Label
                        Text="Fecha de Entrega:"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                        FontSize="14"
                        VerticalOptions="Center"
                        Grid.Column="0" />
                    <Label
                        x:Name="FechaEntregaLabel"
                        FontSize="14"
                        VerticalOptions="Center"
                        HorizontalOptions="End"
                        Grid.Column="1"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFechaEntregaTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Frame>

            <!-- SfDatePicker oculto en Dialog mode -->
            <picker:SfDatePicker
                x:Name="FechaEntregaPicker"
                Mode="Dialog"
                Format="dd_MM_yyyy"
                HeightRequest="0"
                Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                ColumnDividerColor="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}"
                Closed="OnFechaEntregaPickerClosed"
                OkButtonClicked="OnFechaEntregaPickerOk"
                CancelButtonClicked="OnFechaEntregaPickerCancelado">

                <picker:SfDatePicker.HeaderView>
                    <picker:PickerHeaderView
                        Height="50"
                        Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PageBackgroundDark}}">
                        <picker:PickerHeaderView.TextStyle>
                            <picker:PickerTextStyle
                                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource TextPrimaryDark}}" />
                        </picker:PickerHeaderView.TextStyle>
                    </picker:PickerHeaderView>
                </picker:SfDatePicker.HeaderView>

                <picker:SfDatePicker.ColumnHeaderView>
                    <picker:DatePickerColumnHeaderView
                        Height="40"
                        Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource CardAltBackgroundDark}}">
                        <picker:DatePickerColumnHeaderView.TextStyle>
                            <picker:PickerTextStyle
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource TextSecondaryDark}}" />
                        </picker:DatePickerColumnHeaderView.TextStyle>
                    </picker:DatePickerColumnHeaderView>
                </picker:SfDatePicker.ColumnHeaderView>

                <picker:SfDatePicker.SelectionView>
                    <picker:PickerSelectionView
                        Background="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource CardBackgroundDark}}"
                        CornerRadius="5"
                        Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </picker:SfDatePicker.SelectionView>

                <picker:SfDatePicker.TextStyle>
                    <picker:PickerTextStyle
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                </picker:SfDatePicker.TextStyle>

                <picker:SfDatePicker.SelectedTextStyle>
                    <picker:PickerTextStyle
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </picker:SfDatePicker.SelectedTextStyle>

                        <picker:SfDatePicker.FooterView>
                            <picker:PickerFooterView
                                Height="50"
                                Background="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                                DividerColor="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}"
                                OkButtonText="OK"
                                CancelButtonText="Cancelar">
                                <picker:PickerFooterView.TextStyle>
                                    <picker:PickerTextStyle
                                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                        FontAttributes="Bold" />
                                </picker:PickerFooterView.TextStyle>
                            </picker:PickerFooterView>
                        </picker:SfDatePicker.FooterView>

            </picker:SfDatePicker>

            <!-- Botón Agregar Encargo -->
            <Button
                Clicked="OnAgregarEncargoClicked"
                Text="Agregar Encargo"
                BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#A5D6A7}"
                TextColor="White"
                CornerRadius="8"
                FontSize="16"
                Padding="15" />

            <!-- Botón Cancelar -->
            <Button
                Clicked="Cancelar"
                Text="Cancelar"
                BackgroundColor="{AppThemeBinding Light=#FF5722, Dark=#FFAB91}"
                TextColor="White"
                CornerRadius="8"
                FontSize="16"
                Padding="15" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
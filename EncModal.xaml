<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.EncModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Agregar Encargo"
    BackgroundColor="#1e1e1e">
    <!-- Fondo oscuro para combinar con MainPage -->

    <ScrollView>
        <VerticalStackLayout
            Margin="20"
            Padding="20"
            Spacing="20">

            <!-- Título de la página -->
            <Label
                Text="Agregar Encargo"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#cccccc"
                HorizontalOptions="Center" />

            <!-- Campo de cliente -->
            <Frame
                BackgroundColor="#2a2a2a"
                CornerRadius="8"
                Padding="10"
                HasShadow="False">
                <Entry
                    x:Name="EncargoEntry"
                    Placeholder="Nombre del cliente"
                    PlaceholderColor="#7d7c7c"
                    TextColor="#cccccc"
                    BackgroundColor="Transparent" />
            </Frame>

            <!-- Campo de Descripción -->
            <Frame
                BackgroundColor="#2a2a2a"
                CornerRadius="8"
                Padding="10"
                HasShadow="False">
                <Entry
                    x:Name="DescripcionEntry"
                    Placeholder="Descripción"
                    PlaceholderColor="#7d7c7c"
                    TextColor="#cccccc"
                    BackgroundColor="Transparent" />
            </Frame>

            <!-- Campo de Precio -->
            <Frame
                BackgroundColor="#2a2a2a"
                CornerRadius="8"
                Padding="10"
                HasShadow="False">
                <Entry
                    x:Name="PrecioEntry"
                    Keyboard="Numeric"
                    Placeholder="Precio"
                    PlaceholderColor="#7d7c7c"
                    TextColor="#cccccc"
                    BackgroundColor="Transparent" />
            </Frame>

            <!-- Campo de Cantidad -->
            <Frame
                BackgroundColor="#2a2a2a"
                CornerRadius="8"
                Padding="10"
                HasShadow="False">
                <Entry
                    x:Name="CantidadEntry"
                    Keyboard="Numeric"
                    Placeholder="Cantidad"
                    PlaceholderColor="#7d7c7c"
                    TextColor="#cccccc"
                    BackgroundColor="Transparent" />
            </Frame>

            <!-- Campo de Fecha de Entrega -->
            <Frame
                BackgroundColor="#2a2a2a"
                CornerRadius="8"
                Padding="10"
                HasShadow="False">
                <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
                    <Label
                        Text="Fecha de Entrega:"
                        TextColor="#7d7c7c"
                        FontSize="14"
                        VerticalOptions="Center"
                        Grid.Column="0" />
                    <DatePicker
                        x:Name="FechaEntregaDatePicker"
                        TextColor="#cccccc"
                        BackgroundColor="Transparent"
                        Grid.Column="1" />
                </Grid>
            </Frame>

            <!-- Botón Agregar Encargo -->
            <Button
                Clicked="OnAgregarEncargoClicked"
                Text="Agregar Encargo"
                BackgroundColor="#4CAF50"
                TextColor="White"
                CornerRadius="8"
                FontSize="16"
                Padding="15" />

            <!-- Botón Cancelar -->
            <Button
                Clicked="Cancelar"
                Text="Cancelar"
                BackgroundColor="#FF5722"
                TextColor="White"
                CornerRadius="8"
                FontSize="16"
                Padding="15" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
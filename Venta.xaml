<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.Venta"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mercader"
    xmlns:models="clr-namespace:Mercader.Models;assembly=Mercader.Core"
    Title="📊 Ventas"
    BackgroundColor="{AppThemeBinding Light={StaticResource DeepBackground}, Dark={StaticResource DeepBackgroundDark}}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de búsqueda -->
        <SearchBar
            Grid.Row="0"
            x:Name="BarraBusqueda"
            Placeholder="Buscar por producto..."
            PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource InputBackground}, Dark={StaticResource InputBackgroundDark}}"
            CancelButtonColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
            FontSize="15"
            Margin="16,12,16,8"
            TextChanged="OnBusquedaTextChanged" />

        <!-- Filtros horizontales -->
        <HorizontalStackLayout
            Grid.Row="1"
            Spacing="8"
            Margin="16,0,16,12"
            HorizontalOptions="Center">

            <Frame
                x:Name="FiltroTodos"
                Padding="14,8"
                CornerRadius="20"
                BackgroundColor="{StaticResource Primary}"
                BorderColor="Transparent"
                HasShadow="False">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFiltroTapped" CommandParameter="TODOS" />
                </Frame.GestureRecognizers>
                <Label
                    Text="TODOS"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Frame>

            <Frame
                x:Name="FiltroHoy"
                Padding="14,8"
                CornerRadius="20"
                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackground}, Dark={StaticResource InputBackgroundDark}}"
                BorderColor="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}"
                HasShadow="False">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFiltroTapped" CommandParameter="HOY" />
                </Frame.GestureRecognizers>
                <Label
                    Text="HOY"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                    VerticalOptions="Center" />
            </Frame>

            <Frame
                x:Name="FiltroEsteMes"
                Padding="14,8"
                CornerRadius="20"
                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackground}, Dark={StaticResource InputBackgroundDark}}"
                BorderColor="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}"
                HasShadow="False">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFiltroTapped" CommandParameter="ESTE MES" />
                </Frame.GestureRecognizers>
                <Label
                    Text="ESTE MES"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                    VerticalOptions="Center" />
            </Frame>
        </HorizontalStackLayout>

        <!-- Lista de ventas -->
        <CollectionView
            Grid.Row="2"
            x:Name="VentasCollectionView"
            SelectionMode="None"
            ItemSizingStrategy="MeasureAllItems"
            Margin="16,0">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView Margin="0,0,0,12">
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem
                                    BackgroundColor="#4CAF50"
                                    Invoked="OnEditSwipeItemInvoked"
                                    Text="✏️ Editar" />
                                <SwipeItem
                                    BackgroundColor="#F44336"
                                    Invoked="OnDeleteSwipeItemInvoked"
                                    Text="🗑️ Eliminar" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <!-- Tarjeta estilo encargos -->
                        <Frame
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                            BorderColor="Transparent"
                            CornerRadius="16"
                            HasShadow="False">

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemTapped" />
                            </Frame.GestureRecognizers>

                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Fila 0: Descripción (campo principal) -->
                                <Label
                                    Grid.Row="0"
                                    Text="{Binding Descripcion}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    LineBreakMode="TailTruncation" />

                                <!-- Fila 1: Fecha -->
                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        Text="📅 FECHA DE VENTA"
                                        FontSize="10"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                        Margin="0,0,0,2" />
                                    <Label
                                        Grid.Row="1"
                                        Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                        FontSize="14"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </Grid>

                                <!-- Fila 2: Total + Desglose -->
                                <Grid Grid.Row="2" ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Text="TOTAL"
                                            FontSize="10"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                            Margin="0,0,0,2" />
                                        <Label
                                            Grid.Row="1"
                                            Text="{Binding TotalFormateado, StringFormat='${0}'}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="#FF9800" />
                                    </Grid>

                                    <Grid Grid.Column="1" HorizontalOptions="Start">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Text="DESGLOSE"
                                            FontSize="10"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                            Margin="0,0,0,2" />

                                        <!-- Desglose dinámico (legacy o multi-artículo) -->
                                        <VerticalStackLayout
                                            Grid.Row="1"
                                            Spacing="2"
                                            HorizontalOptions="Start">
                                            <BindableLayout.ItemsSource>
                                                <Binding Path="DesgloseItems" />
                                            </BindableLayout.ItemsSource>
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:DesgloseItem">
                                                    <VerticalStackLayout Spacing="0" HorizontalOptions="Start">
                                                        <!-- Descripción del artículo (si existe) -->
                                                        <Label
                                                            Text="{Binding Descripcion}"
                                                            FontSize="10"
                                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                            HorizontalTextAlignment="Start"
                                                            LineBreakMode="TailTruncation"
                                                            IsVisible="{Binding Descripcion, Converter={StaticResource StringNotEmpty}}" />
                                                        <!-- Texto del desglose ($Precio x Cantidad) -->
                                                        <Label
                                                            Text="{Binding Texto}"
                                                            FontSize="13"
                                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                            HorizontalTextAlignment="Start" />
                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>

                                <!-- Fila 3: Acciones -->
                                <HorizontalStackLayout
                                    Grid.Row="3"
                                    HorizontalOptions="End"
                                    Spacing="16">
                                    <Label
                                        Text="✏️"
                                        FontSize="20"
                                        VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnEditarTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label
                                        Text="🗑️"
                                        FontSize="20"
                                        VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnEliminarTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </HorizontalStackLayout>
                            </Grid>
                        </Frame>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Mensaje cuando no hay ventas -->
            <CollectionView.EmptyView>
                <StackLayout
                    Padding="20"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="15">

                    <Label
                        FontSize="48"
                        Text="📊"
                        HorizontalTextAlignment="Center" />

                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="No hay ventas registradas"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        FontSize="14"
                        Text="Las ventas aparecerán aquí cuando se registren"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                        HorizontalTextAlignment="Center" />
                </StackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
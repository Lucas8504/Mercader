<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.Venta"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mercader"
    Title="📊 Registro de Ventas"
    BackgroundColor="#0f0f0f">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Lista de ventas -->
        <ScrollView Grid.Row="1" Margin="10,0">
            <StackLayout Spacing="12">
                <CollectionView
                    x:Name="VentasCollectionView"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureAllItems">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <SwipeView Margin="5,2">
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItem
                                            BackgroundColor="#4CAF50"
                                            Invoked="OnEditSwipeItemInvoked"
                                            Text="✏️ Editar" />
                                        <SwipeItem
                                            BackgroundColor="#F44336"
                                            Invoked="OnDeleteSwipeItemInvoked"
                                            Text="🗑️ Eliminar" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <!-- Tarjeta de venta minimalista moderna -->
                                <Frame
                                    Padding="16"
                                    BackgroundColor="#252525"
                                    BorderColor="Transparent"
                                    CornerRadius="16"
                                    HasShadow="False">

                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnItemTapped" />
                                    </Frame.GestureRecognizers>

                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Fila 1: Descripción y Cantidad -->
                                        <Grid Grid.Row="0" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Descripción -->
                                            <Label
                                                Grid.Column="0"
                                                FontAttributes="Bold"
                                                FontSize="17"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding Descripcion}"
                                                TextColor="#E8E8E8"
                                                VerticalOptions="Center" />

                                            <!-- Cantidad -->
                                            <Label
                                                Grid.Column="1"
                                                FontSize="12"
                                                Text="{Binding Cantidad, StringFormat='{0} unid.'}"
                                                TextColor="#888888"
                                                VerticalOptions="Center" />
                                        </Grid>

                                        <!-- Fila 2: Total y Precio Unitario -->
                                        <Grid Grid.Row="1" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Total -->
                                            <Frame
                                                Grid.Column="0"
                                                BackgroundColor="#1E4A1E"
                                                BorderColor="#2E6A2E"
                                                CornerRadius="8"
                                                Padding="10"
                                                HasShadow="False">
                                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                    <Label
                                                        Text="Total"
                                                        FontSize="10"
                                                        TextColor="#6BB3E0" />
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="15"
                                                        Text="{Binding TotalFormateado}"
                                                        TextColor="#9FC5E8" />
                                                </VerticalStackLayout>
                                            </Frame>

                                            <!-- Precio Unitario -->
                                            <Frame
                                                Grid.Column="1"
                                                BackgroundColor="#1E3A5F"
                                                BorderColor="#2E5A8F"
                                                CornerRadius="8"
                                                Padding="10"
                                                HasShadow="False">
                                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                    <Label
                                                        Text="x Unidad"
                                                        FontSize="10"
                                                        TextColor="#8AB88A" />
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="15"
                                                        Text="{Binding Precio, StringFormat='${0:N2}'}"
                                                        TextColor="#A8D5A2" />
                                                </VerticalStackLayout>
                                            </Frame>
                                        </Grid>

                                        <!-- Fila 3: Fecha -->
                                        <Label
                                            Grid.Row="2"
                                            FontSize="12"
                                            Text="{Binding Fecha, StringFormat='{0:dd MMM yyyy}'}"
                                            TextColor="#6A6A6A" />
                                    </Grid>
                                </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- Mensaje cuando no hay ventas -->
                    <CollectionView.EmptyView>
                        <StackLayout
                            Padding="20"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Spacing="15">

                            <Label
                                FontSize="48"
                                Text="📊"
                                HorizontalTextAlignment="Center" />

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="No hay ventas registradas"
                                TextColor="#cccccc"
                                HorizontalTextAlignment="Center" />

                            <Label
                                FontSize="14"
                                Text="Las ventas aparecerán aquí cuando se registren"
                                TextColor="#888888"
                                HorizontalTextAlignment="Center" />
                        </StackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- Espaciado al final -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent" />
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.Venta"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Venta">
    <ScrollView>
        <VerticalStackLayout
        Margin="10"
        Padding="10"
        Spacing="20">
            <Label
            HorizontalOptions="Center"
            Text="ventas"
            VerticalOptions="Center" />

            <!-- Encabezados de las columnas -->
            <Grid Padding="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Text="Descripción" FontAttributes="Bold" />
                <Label Grid.Column="1" Text="Precio" FontAttributes="Bold" />
                <Label Grid.Column="2" Text="Cantidad" FontAttributes="Bold" />
                <Label Grid.Column="3" Text="Fecha" FontAttributes="Bold" />
            </Grid>

            <CollectionView x:Name="VentasCollectionView" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Editar" BackgroundColor="LightBlue" Invoked="OnEditSwipeItemInvoked"/>
                                    <SwipeItem Text="Eliminar" BackgroundColor="LightCoral" Invoked="OnDeleteSwipeItemInvoked"/>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            
                                    <Grid Padding="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Text="{Binding Descripcion}" TextColor="Coral" />
                                        <Label Grid.Column="1" Text="{Binding Precio}" TextColor="Coral"/>
                                        <Label Grid.Column="2" Text="{Binding Cantidad}" TextColor="Coral"/>
                                        <Label Grid.Column="3" Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" TextColor="Coral"/>
                                    </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
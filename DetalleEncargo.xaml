<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.DetalleEncargo"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:domain="clr-namespace:Mercader.Domain.Entities;assembly=Mercader.Core"
    Title="Detalle del Encargo"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout
            Margin="20"
            Padding="20"
            Spacing="20">

            <!-- Card con los detalles -->
            <Frame
                Padding="20"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="12"
                HasShadow="True">
                <VerticalStackLayout Spacing="15">

                    <!-- Nombre del cliente -->
                    <VerticalStackLayout Spacing="5">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Cliente:"
                            TextColor="#4CAF50" />
                        <Label
                            x:Name="LabelNombre"
                            FontSize="18"
                            Text="{Binding Nombre}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    </VerticalStackLayout>

                    <!-- Descripción -->
                    <VerticalStackLayout Spacing="5">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Descripción:"
                            TextColor="#4CAF50" />
                        <Label
                            x:Name="LabelDescripcion"
                            FontSize="16"
                            Text="{Binding Descripcion}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    </VerticalStackLayout>

                    <!-- Fechas en una fila -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Fecha del encargo -->
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Fecha del Encargo:"
                                TextColor="#4CAF50" />
                            <Label
                                x:Name="LabelFecha"
                                FontSize="16"
                                Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </VerticalStackLayout>

                        <!-- Fecha de entrega -->
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Fecha de Entrega:"
                                TextColor="#4CAF50" />
                            <Label
                                x:Name="LabelFechaEntrega"
                                FontSize="16"
                                Text="{Binding FechaEntrega, StringFormat='{0:dd/MM/yyyy}'}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Frame>

            <!-- ===== ARTÍCULOS ===== -->
            <Label
                FontAttributes="Bold"
                FontSize="16"
                Text="Artículos:"
                TextColor="#4CAF50" />

            <VerticalStackLayout
                x:Name="ArticulosStack"
                Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="domain:ArticuloEncargo">
                        <Frame
                            Padding="10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                            CornerRadius="8"
                            HasShadow="False">
                            <Grid
                                ColumnDefinitions="*,Auto,Auto"
                                RowDefinitions="Auto,Auto"
                                ColumnSpacing="8"
                                RowSpacing="4">
                                <!-- Descripción -->
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    Text="{Binding Descripcion}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <!-- Precio Unitario -->
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    FontSize="13"
                                    Text="{Binding PrecioUnitario, StringFormat='P/U: ${0:F2}'}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                    VerticalOptions="Center" />
                                <!-- Cantidad -->
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontSize="13"
                                    Text="{Binding Cantidad, StringFormat='{0} uds.'}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                    VerticalOptions="Center" />
                                <!-- Total del artículo -->
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    Text="{Binding Total, StringFormat='${0:F2}'}"
                                    TextColor="#FFC107"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Total calculado -->
            <Frame
                Padding="12"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Total:"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        VerticalOptions="Center" />
                    <Label
                        x:Name="LabelTotal"
                        Grid.Column="2"
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="$0"
                        TextColor="#FFC107"
                        VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- Botones de acción -->
            <VerticalStackLayout Spacing="15">

                <!-- Botón Concretar Venta -->
                <Button
                    x:Name="BtnConcretarVenta"
                    BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#A5D6A7}"
                    Clicked="OnConcretarVentaClicked"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="50"
                    Text="🛒 Concretar Venta"
                    TextColor="White" />

                <!-- Botón Editar -->
                <Button
                    x:Name="BtnEditar"
                    BackgroundColor="#2196F3"
                    Clicked="OnEditarClicked"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="50"
                    Text="✏️ Editar Encargo"
                    TextColor="White" />

                <!-- Botón Eliminar -->
                <Button
                    x:Name="BtnEliminar"
                    BackgroundColor="#FF5722"
                    Clicked="OnEliminarClicked"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="50"
                    Text="🗑️ Eliminar Encargo"
                    TextColor="White" />

                <!-- Botón Volver -->
                <Button
                    x:Name="BtnVolver"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ButtonSecondaryLight}, Dark={StaticResource ButtonSecondaryDark}}"
                    Clicked="OnVolverClicked"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="50"
                    Text="⬅️ Volver"
                    TextColor="White" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
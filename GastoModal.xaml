<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.GastoModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Nuevo Gasto"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <!--  Fondo oscuro para combinar con MainPage  -->

    <ScrollView>
        <VerticalStackLayout
            Margin="20"
            Padding="20"
            Spacing="20">

            <!--  Título de la página  -->
            <Label
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Center"
                Text="Nuevo Gasto"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <!--  Campo de Descripción con autocompletado  -->
            <Frame
                Padding="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Entry
                    x:Name="DescripcionGastoEntry"
                    BackgroundColor="Transparent"
                    Placeholder="Descripción del gasto"
                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    TextChanged="OnDescripcionGastoTextChanged" />
            </Frame>

            <!--  Lista de sugerencias para autocompletado  -->
            <Frame
                x:Name="GastoSuggestionsFrame"
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False"
                IsVisible="False"
                MaximumHeightRequest="200">
                <CollectionView
                    x:Name="GastoSuggestionsView"
                    SelectionMode="Single"
                    SelectionChanged="OnGastoSuggestionSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid
                                Padding="12,10"
                                ColumnSpacing="0"
                                BackgroundColor="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnGastoSuggestionTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Grid.Column="0"
                                    Text="{Binding .}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    FontSize="15"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="✕"
                                    TextColor="#FF5252"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    Padding="8,4">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnGastoDismissSuggestionTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>

            <!--  Campo de Monto  -->
            <Frame
                Padding="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Entry
                    x:Name="MontoGastoEntry"
                    BackgroundColor="Transparent"
                    Keyboard="Numeric"
                    Placeholder="Monto"
                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
            </Frame>

            <!--  Campo de Cantidad  -->
            <Frame
                Padding="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Entry
                    x:Name="CantidadG_Entry"
                    BackgroundColor="Transparent"
                    Keyboard="Numeric"
                    Placeholder="Cantidad"
                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
            </Frame>

            <!--  Botón Agregar Gasto  -->
            <Button
                Padding="15"
                BackgroundColor="#4CAF50"
                Clicked="OnAgregarGastoClicked"
                CornerRadius="8"
                FontSize="16"
                Text="Agregar Gasto"
                TextColor="White" />

            <!--  Botón Cancelar  -->
            <Button
                Padding="15"
                BackgroundColor="#FF5722"
                Clicked="Cancelar"
                CornerRadius="8"
                FontSize="16"
                Text="Cancelar"
                TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
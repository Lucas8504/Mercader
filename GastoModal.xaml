<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.GastoModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Nuevo Gasto"
    BackgroundColor="#1e1e1e">
    <!--  Fondo oscuro para combinar con MainPage  -->

    <ScrollView>
        <VerticalStackLayout
            Margin="20"
            Padding="20"
            Spacing="20">

            <!--  Título de la página  -->
            <Label
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Center"
                Text="Nuevo Gasto"
                TextColor="#cccccc" />

            <!--  Campo de Descripción  -->
            <Frame
                Padding="10"
                BackgroundColor="#2a2a2a"
                CornerRadius="8"
                HasShadow="False">
                <Entry
                    x:Name="DescripcionGastoEntry"
                    BackgroundColor="Transparent"
                    Placeholder="Descripción del gasto"
                    PlaceholderColor="#7d7c7c"
                    TextColor="#cccccc" />
            </Frame>

            <!--  Campo de Monto  -->
            <Frame
                Padding="10"
                BackgroundColor="#2a2a2a"
                CornerRadius="8"
                HasShadow="False">
                <Entry
                    x:Name="MontoGastoEntry"
                    BackgroundColor="Transparent"
                    Keyboard="Numeric"
                    Placeholder="Monto"
                    PlaceholderColor="#7d7c7c"
                    TextColor="#cccccc" />
            </Frame>

            <!--  Campo de Cantidad  -->
            <Frame
                Padding="10"
                BackgroundColor="#2a2a2a"
                CornerRadius="8"
                HasShadow="False">
                <Entry
                    x:Name="CantidadG_Entry"
                    BackgroundColor="Transparent"
                    Keyboard="Numeric"
                    Placeholder="Cantidad"
                    PlaceholderColor="#7d7c7c"
                    TextColor="#cccccc" />
            </Frame>

            <!--  Botón Agregar Gasto  -->
            <Button
                Padding="15"
                BackgroundColor="#4CAF50"
                Clicked="OnAgregarGastoClicked"
                CornerRadius="8"
                FontSize="16"
                Text="Agregar Gasto"
                TextColor="White" />

            <!--  Botón Cancelar  -->
            <Button
                Padding="15"
                BackgroundColor="#FF5722"
                Clicked="Cancelar"
                CornerRadius="8"
                FontSize="16"
                Text="Cancelar"
                TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
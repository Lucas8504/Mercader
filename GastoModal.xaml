<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mercader.GastoModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:domain="clr-namespace:Mercader.Domain.Entities;assembly=Mercader.Core"
    xmlns:vm="clr-namespace:Mercader.Core.ViewModels;assembly=Mercader.Core"
    Title="Nuevo Gasto"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <!--  Fondo oscuro para combinar con MainPage  -->

    <ScrollView>
        <VerticalStackLayout
            Margin="20"
            Padding="20"
            Spacing="20">

            <!--  Título de la página  -->
            <Label
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Center"
                Text="Nuevo Gasto"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <!--  Campo de Descripción con autocompletado  -->
            <Frame
                Padding="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Entry
                    x:Name="DescripcionGastoEntry"
                    BackgroundColor="Transparent"
                    Placeholder="Descripción del gasto"
                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    Visual="Material"
                    TextChanged="OnDescripcionGastoTextChanged" />
            </Frame>

            <!--  Lista de sugerencias para autocompletado  -->
            <Frame
                x:Name="GastoSuggestionsFrame"
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False"
                IsVisible="False"
                MaximumHeightRequest="200">
                <CollectionView
                    x:Name="GastoSuggestionsView"
                    SelectionMode="Single"
                    SelectionChanged="OnGastoSuggestionSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid
                                Padding="12,10"
                                ColumnSpacing="0"
                                BackgroundColor="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnGastoSuggestionTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Grid.Column="0"
                                    Text="{Binding .}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    FontSize="15"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="✕"
                                    TextColor="#FF5252"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    Padding="8,4">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnGastoDismissSuggestionTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>

            <!--  ===== MULTI-ARTÍCULO =====  -->
            <Label
                FontAttributes="Bold"
                FontSize="16"
                Text="Artículos"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <VerticalStackLayout
                x:Name="ArticulosStack"
                Spacing="8"
                BindableLayout.ItemsSource="{Binding Articulos}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="domain:ArticuloGasto">
                        <Frame
                            Padding="12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                            CornerRadius="8"
                            HasShadow="False">
                            <VerticalStackLayout Spacing="8">
                                <!-- Descripción + cámara en la misma fila -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label
                                            FontSize="11"
                                            Text="Descripción"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                        <Entry
                                            BackgroundColor="Transparent"
                                            Placeholder="Nombre del artículo"
                                            PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                            Text="{Binding Descripcion, Mode=TwoWay}"
                                            TextChanged="OnArticuloFieldChanged"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            Visual="Material" />
                                    </VerticalStackLayout>
                                    <Button
                                        Grid.Column="1"
                                        WidthRequest="36" HeightRequest="36"
                                        Padding="0"
                                        BackgroundColor="{AppThemeBinding Light=#487CE4, Dark=#90CAF9}"
                                        CornerRadius="18"
                                        FontSize="16"
                                        Text="📷"
                                        TextColor="White"
                                        VerticalOptions="End"
                                        Clicked="OnOpenImageGalleryClicked" />
                                </Grid>

                                <!-- Precio y Cantidad en fila -->
                                <Grid ColumnDefinitions="*,8,*" ColumnSpacing="0">
                                    <!-- Precio Unitario -->
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label
                                            FontSize="11"
                                            Text="Precio Unitario"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                        <Entry
                                            BackgroundColor="Transparent"
                                            Keyboard="Numeric"
                                            Placeholder="0"
                                            PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                            Text="{Binding PrecioUnitario, Mode=TwoWay, Converter={StaticResource DecimalToEmpty}}"
                                            TextChanged="OnArticuloFieldChanged"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            Visual="Material" />
                                    </VerticalStackLayout>

                                    <!-- Cantidad -->
                                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                                        <Label
                                            FontSize="11"
                                            Text="Cantidad"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                        <Entry
                                            BackgroundColor="Transparent"
                                            Keyboard="Numeric"
                                            Placeholder="1"
                                            PlaceholderColor="{AppThemeBinding Light={StaticResource TextPlaceholder}, Dark={StaticResource TextPlaceholderDark}}"
                                            Text="{Binding Cantidad, Mode=TwoWay, Converter={StaticResource DecimalToEmpty}}"
                                            TextChanged="OnArticuloFieldChanged"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            Visual="Material" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Botones de acción -->
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                    <Button
                                        Grid.Column="1"
                                        BackgroundColor="Transparent"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type Page}}, Path=BindingContext.SubirArticuloCommand}"
                                        CommandParameter="{Binding .}"
                                        FontSize="14"
                                        Padding="4"
                                        Text="⬆" />
                                    <Button
                                        Grid.Column="2"
                                        BackgroundColor="Transparent"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type Page}}, Path=BindingContext.BajarArticuloCommand}"
                                        CommandParameter="{Binding .}"
                                        FontSize="14"
                                        Padding="4"
                                        Text="⬇" />
                                    <Button
                                        Grid.Column="3"
                                        BackgroundColor="#FF5252"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type Page}}, Path=BindingContext.EliminarArticuloCommand}"
                                        CommandParameter="{Binding .}"
                                        FontSize="14"
                                        Padding="4"
                                        Text="✕"
                                        TextColor="White" />
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!--  Botón Agregar Artículo  -->
            <Button
                Padding="10"
                BackgroundColor="{AppThemeBinding Light=#2196F3, Dark=#90CAF9}"
                Command="{Binding AgregarArticuloCommand}"
                CornerRadius="8"
                FontSize="14"
                Text="+ Agregar artículo"
                TextColor="White" />

            <!--  Lista de sugerencias para autocompletado de artículos  -->
            <Frame
                x:Name="ArticuloSuggestionsFrame"
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False"
                IsVisible="False"
                MaximumHeightRequest="200">
                <CollectionView
                    x:Name="ArticuloSuggestionsView"
                    SelectionMode="Single"
                    SelectionChanged="OnArticuloSuggestionSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid
                                Padding="12,10"
                                ColumnSpacing="0"
                                BackgroundColor="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnArticuloSuggestionTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Grid.Column="0"
                                    Text="{Binding .}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    FontSize="15"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="✕"
                                    TextColor="#FF5252"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    Padding="8,4">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnArticuloDismissSuggestionTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>

            <!--  Total calculado  -->
            <Frame
                Padding="12"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardAltBackground}, Dark={StaticResource CardAltBackgroundDark}}"
                CornerRadius="8"
                HasShadow="False">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Total:"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        VerticalOptions="Center" />
                    <Label
                        x:Name="TotalLabel"
                        Grid.Column="2"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="{Binding Total, StringFormat='${0}'}"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!--  Botón Agregar Gasto  -->
            <Button
                Padding="15"
                BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#A5D6A7}"
                Clicked="OnAgregarGastoClicked"
                CornerRadius="8"
                FontSize="16"
                Text="Agregar Gasto"
                TextColor="White" />

            <!--  Botón Cancelar  -->
            <Button
                Padding="15"
                BackgroundColor="{AppThemeBinding Light=#FF5722, Dark=#FFAB91}"
                Clicked="Cancelar"
                CornerRadius="8"
                FontSize="16"
                Text="Cancelar"
                TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>